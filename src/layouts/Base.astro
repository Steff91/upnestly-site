---
import '../styles/global.css';
import TopBar from '../components/TopBar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import PreviewGate from '../components/PreviewGate.astro';
import MobileCta from '../components/MobileCta.astro';
import { previewGateOn, previewHash } from '../lib/preview';
import { getSite } from '../i18n/data';
import { getLang, langMeta, langs, switchLang } from '../i18n';

interface Props {
  title: string;
  description?: string;
  /** Keep the page out of search results (e.g. legal pages with placeholder content). */
  noindex?: boolean;
}

const lang = getLang(Astro.url);
const site = getSite(lang);
const { title, description = site.description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Every page exists in both languages under the same slug (/x/ and /de/x/).
const alternates = langs.map((l) => ({ lang: langMeta[l].html, href: new URL(switchLang(Astro.url.pathname, l), Astro.site).toString() }));
const xDefault = new URL(switchLang(Astro.url.pathname, 'en'), Astro.site).toString();
// Until launch (PUBLIC_SITE_LIVE=true), every page tells crawlers to stay out.
const live = import.meta.env.PUBLIC_SITE_LIVE === 'true';
const robots = !live ? 'noindex, nofollow, noarchive, noimageindex' : noindex ? 'noindex, follow' : undefined;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  description: site.description,
  url: new URL(lang === 'de' ? '/de/' : '/', Astro.site).toString(),
  email: site.email,
  logo: new URL('/logo/upnestly.png', Astro.site).toString(),
  image: new URL('/og-image.png', Astro.site).toString(),
  address: { '@type': 'PostalAddress', addressLocality: site.city, addressCountry: 'RS' },
  areaServed: ['Europe', 'DACH', 'United Kingdom', 'United States'],
  knowsLanguage: ['en', 'de'],
  inLanguage: langMeta[lang].html,
  sameAs: [site.linkedin, site.github].filter((u) => u.startsWith('http')),
};
---

<!doctype html>
<html lang={langMeta[lang].html}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {robots && <meta name="robots" content={robots} />}
    {!noindex && alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={xDefault} />}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og-image.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:locale" content={langMeta[lang].og} />
    {langs.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={langMeta[l].og} />)}
    <meta name="theme-color" content="#2D327D" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    {previewGateOn && (
      <script is:inline define:vars={{ previewHash }}>
        try { if (localStorage.getItem('upn-preview') !== previewHash) document.documentElement.classList.add('gated'); }
        catch { document.documentElement.classList.add('gated'); }
      </script>
    )}
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <slot name="head" />
  </head>
  <body>
    {previewGateOn && <PreviewGate />}
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-white focus:px-4 focus:py-2">{lang === 'de' ? 'Zum Inhalt springen' : 'Skip to content'}</a>
    <TopBar />
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <MobileCta />
    <CookieBanner />

    <script>
      // Subtle reveal: elements with [data-reveal] fade up once, staggered by --i.
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.1 },
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add('is-visible'));
      }

      // FAQ: animate opening and closing of <details class="faq"> (skipped when reduced motion is preferred).
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      document.querySelectorAll<HTMLDetailsElement>('details.faq').forEach((d) => {
        const summary = d.querySelector('summary');
        const body = d.querySelector<HTMLElement>('.faq-body');
        if (!summary || !body) return;
        let running: Animation | null = null;
        summary.addEventListener('click', (e) => {
          if (reduceMotion.matches) return;
          e.preventDefault();
          running?.cancel();
          const opts = { duration: 280, easing: 'cubic-bezier(.2,.7,.2,1)' };
          if (d.open) {
            running = body.animate([{ height: `${body.offsetHeight}px`, opacity: 1 }, { height: '0px', opacity: 0 }], opts);
            running.onfinish = () => { d.open = false; running = null; };
          } else {
            d.open = true;
            running = body.animate([{ height: '0px', opacity: 0 }, { height: `${body.offsetHeight}px`, opacity: 1 }], opts);
            running.onfinish = () => { running = null; };
          }
        });
      });

      // Mobile menu: the hamburger toggles it; picking a link, clicking/tapping outside or pressing Esc closes it.
      const menu = document.querySelector<HTMLDetailsElement>('[data-mobile-menu]');
      if (menu) {
        const close = () => menu.removeAttribute('open');
        menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
        // The tap that closes the menu shouldn't also hit a link or button underneath it.
        const swallow = (e: Event) => { e.preventDefault(); e.stopPropagation(); };
        document.addEventListener('pointerdown', (e) => {
          if (!menu.open || menu.contains(e.target as Node)) return;
          close();
          document.addEventListener('click', swallow, { capture: true, once: true });
          setTimeout(() => document.removeEventListener('click', swallow, { capture: true }), 600);
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && menu.open) { close(); menu.querySelector('summary')?.focus(); }
        });
      }
    </script>
  </body>
</html>
