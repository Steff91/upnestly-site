---
import Base from './Base.astro';
import { getLang, localize } from '../i18n';

interface Props {
  title: string;
  description?: string;
  updated?: string;
  noindex?: boolean;
}
const { title, description, updated, noindex = false } = Astro.props;

const lang = getLang(Astro.url);
const t = {
  en: { eyebrow: 'Legal', updated: 'Last updated', nav: 'Legal pages', settings: 'Cookie settings', imprint: 'Imprint', privacy: 'Privacy policy', cookies: 'Cookie policy' },
  de: { eyebrow: 'Rechtliches', updated: 'Stand', nav: 'Rechtliche Seiten', settings: 'Cookie-Einstellungen', imprint: 'Impressum', privacy: 'Datenschutzerklärung', cookies: 'Cookie-Richtlinie' },
}[lang];
const legalNav = [
  { href: localize('/imprint/', lang), label: t.imprint },
  { href: localize('/privacy/', lang), label: t.privacy },
  { href: localize('/cookies/', lang), label: t.cookies },
];
const current = Astro.url.pathname;
// Soft hyphen so long German compounds can break on phones.
const heading = title.replace('Datenschutzerklärung', 'Datenschutz\u00ADerklärung');
---

<Base title={`${title} — Upnestly`} description={description} noindex={noindex}>
  <section class="bg-tint">
    <div class="container-site flex flex-col gap-4 py-18">
      <p class="eyebrow m-0">{t.eyebrow}</p>
      <h1 class="h-hero">{heading}</h1>
      {updated && <p class="m-0 text-[14px] text-muted">{t.updated}: {updated}</p>}
    </div>
  </section>
  <section>
    <div class="container-site flex flex-wrap gap-x-16 gap-y-10 py-16">
      <nav aria-label={t.nav} class="flex min-w-0 flex-[0_1_200px] flex-col gap-1 lg:sticky lg:top-28 lg:self-start">
        {legalNav.map((l) => (
          <a
            href={l.href}
            aria-current={current === l.href ? 'page' : undefined}
            class:list={['rounded-xl px-4 py-2.5 text-[15px] font-semibold no-underline', current === l.href ? 'bg-tint text-brand' : 'text-body hover:bg-tint-soft hover:text-brand']}
          >
            {l.label}
          </a>
        ))}
        <button type="button" data-open-cookie-settings class="cursor-pointer rounded-xl border-0 bg-transparent px-4 py-2.5 text-left text-[15px] font-semibold text-body transition-colors duration-300 hover:bg-tint-soft hover:text-brand">
          {t.settings}
        </button>
      </nav>
      <div class="legal flex min-w-0 max-w-[760px] flex-[1_1_520px] flex-col gap-4 text-[16px] leading-[1.7] text-body">
        <slot />
      </div>
    </div>
  </section>
</Base>

<style>
  .legal :global(h2) { margin: 1.75rem 0 0; font-size: 22px; font-weight: 700; line-height: 1.3; color: var(--color-ink); }
  .legal :global(h3) { margin: 1rem 0 0; font-size: 17px; font-weight: 700; color: var(--color-ink); }
  .legal :global(p), .legal :global(ul), .legal :global(ol), .legal :global(dl) { margin: 0; }
  .legal :global(ul), .legal :global(ol) { padding-left: 1.2rem; }
  .legal :global(ul) { list-style: disc; }
  .legal :global(ol) { list-style: decimal; }
  .legal :global(li + li) { margin-top: .35rem; }
  .legal :global(strong) { color: var(--color-ink); }
  .legal :global(dt) { font-weight: 700; color: var(--color-ink); }
  .legal :global(dd) { margin: 0 0 .9rem; }
  .legal :global(table) { width: 100%; border-collapse: collapse; font-size: 15px; display: block; overflow-x: auto; }
  .legal :global(th), .legal :global(td) { hyphens: auto; overflow-wrap: break-word; border-bottom: 1px solid var(--color-line); padding: .7rem .8rem; text-align: left; vertical-align: top; }
  .legal :global(th) { color: var(--color-ink); background: var(--color-tint-soft); }
  .legal :global(blockquote) { margin: 0; border-radius: 14px; background: var(--color-tint); padding: 1rem 1.25rem; color: var(--color-ink); font-size: 15px; }
  .legal :global(blockquote p) { margin: 0; }
  .legal :global(code) { font-size: .9em; background: var(--color-tint-soft); padding: .1em .35em; border-radius: 6px; }
</style>
