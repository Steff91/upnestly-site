---
// Redirect target for the form provider after a successful submission (configure it there).
import Base from '../layouts/Base.astro';
import BrandMark from '../components/BrandMark.astro';
---

<Base title="Thank you — Upnestly" noindex>
  <section class="relative overflow-hidden bg-tint">
    <BrandMark variant="blue" class="-right-20 top-1/2 w-[520px] -translate-y-1/2 opacity-[0.08]" />
    <div class="container-site relative flex flex-col items-start gap-6 py-32">
      <p class="eyebrow m-0">Message sent</p>
      <h1 class="h-hero max-w-[760px]">Thank you — we’ll be in touch soon.</h1>
      <p class="m-0 max-w-[560px] text-[19px] leading-[1.55] text-body">We usually reply [within one business day]. In the meantime, have a look at our work.</p>
      <div class="flex flex-wrap gap-3.5">
        <a href="/work/" class="btn btn-primary">See our work</a>
        <a href="/" class="btn btn-outline">Back to the homepage</a>
      </div>
    </div>
  </section>
</Base>
