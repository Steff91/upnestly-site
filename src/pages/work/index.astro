---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import BrandMark from '../../components/BrandMark.astro';
import WorkCard from '../../components/WorkCard.astro';
import Contact from '../../components/sections/Contact.astro';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const filters = ['All', 'Build', 'Grow', 'Run'] as const;
---

<Base
  title="Work — Case Studies | Upnestly"
  description="Case studies from Upnestly: websites, shops, SEO, CRO, AI automation and hosting projects — with the results they brought."
>
  <section class="relative overflow-hidden bg-tint">
    <BrandMark variant="blue" class="-bottom-48 -right-24 hidden w-[600px] opacity-[0.07] lg:block" />
    <div class="container-site relative flex flex-col gap-6 py-18 lg:py-22">
      <p class="eyebrow m-0" data-reveal>Work</p>
      <h1 class="h-hero max-w-[860px]" data-reveal style="--i:1">Results, not just launches.</h1>
      <p class="m-0 max-w-[660px] text-[19px] leading-[1.55] text-body" data-reveal style="--i:2">
        A selection of projects across development, growth and hosting — and what they changed for the business.
      </p>
    </div>
  </section>

  <section>
    <div class="container-site flex flex-col gap-10 py-18">
      <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Filter projects by discipline" data-work-filters>
        {filters.map((f, i) => (
          <button type="button" class="filter-btn min-h-11 rounded-full border border-line px-5 text-[15px] font-semibold" data-filter={f} aria-pressed={i === 0 ? 'true' : 'false'}>
            {f}
          </button>
        ))}
        <span class="ml-auto text-[14px] text-muted" aria-live="polite" data-work-count>{work.length} projects</span>
      </div>

      <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,340px),1fr))] gap-6" data-work-grid>
        {work.map((entry, i) => <WorkCard entry={entry} index={i} />)}
      </div>
    </div>
  </section>

  <Contact />
</Base>

<style>
  .filter-btn { color: var(--color-body); background: #fff; }
  .filter-btn[aria-pressed='true'] { background: var(--color-brand); border-color: var(--color-brand); color: #fff; }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-work-filters] [data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-work-grid] .work-card');
  const count = document.querySelector<HTMLElement>('[data-work-count]');
  buttons.forEach((btn) =>
    btn.addEventListener('click', () => {
      const f = btn.dataset.filter ?? 'All';
      let visible = 0;
      cards.forEach((card) => {
        const show = f === 'All' || (card.dataset.disciplines ?? '').split(' ').includes(f);
        card.hidden = !show;
        if (show) visible++;
      });
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      if (count) count.textContent = `${visible} project${visible === 1 ? '' : 's'}`;
    }),
  );
</script>
