---
// Markdown legal pages (src/content/legal/*.md) → /privacy/, /cookies/, …
import { getCollection, render } from 'astro:content';
import Legal from '../layouts/Legal.astro';

export async function getStaticPaths() {
  const docs = await getCollection('legal');
  return docs.map((doc) => ({ params: { legal: doc.id }, props: { doc } }));
}

const { doc } = Astro.props;
const { Content } = await render(doc);
---

<Legal title={doc.data.title} description={doc.data.description} updated={doc.data.updated} noindex={doc.data.noindex}>
  <Content />
</Legal>
