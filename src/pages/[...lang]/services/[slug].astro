---
import Base from '../../../layouts/Base.astro';
import BrandMark from '../../../components/BrandMark.astro';
import Icon from '../../../components/Icon.astro';
import Placeholder from '../../../components/Placeholder.astro';
import Contact from '../../../components/sections/Contact.astro';
import { getPlans, getSite } from '../../../i18n/data';
import type { CollectionEntry } from 'astro:content';
import { defaultLang, fromPrice, getLang, langs, localize } from '../../../i18n';
import { getLocalized, slugOf } from '../../../i18n/content';

export async function getStaticPaths() {
  // AI automation has its own page (ai-automation.astro); its .md still feeds the hub cards and plan table.
  const paths: { params: { lang?: string; slug: string }; props: { service: CollectionEntry<'services'> } }[] = [];
  for (const lang of langs) {
    for (const service of await getLocalized('services', lang)) {
      if (slugOf(service) === 'ai-automation') continue;
      paths.push({ params: { lang: lang === defaultLang ? undefined : lang, slug: slugOf(service) }, props: { service } });
    }
  }
  return paths;
}

const { service } = Astro.props;
const lang = getLang(Astro.url);
const site = getSite(lang);
const plans = getPlans(lang);
const s = service.data;
const work = s.relatedWork ? (await getLocalized('work', lang)).find((w) => slugOf(w) === s.relatedWork) : undefined;
const others = (await getLocalized('services', lang))
  .filter((o) => o.id !== service.id)
  .sort((a, b) => a.data.order - b.data.order);
const t = {
  en: {
    home: 'Home', services: 'Services', breadcrumb: 'Breadcrumb', audit: 'Book a free audit', fits: 'How it fits your plan',
    plansTitle: 'Included in every plan — at a different scope.', plansLead: 'You don’t buy this on its own. It runs alongside your website, marketing, apps and hosting on one monthly plan.',
    perMonth: '/ month', compareAll: 'Compare all plans', how: 'How we work', step: 'Step', tools: 'Tools we use',
    screenshot: 'Project screenshot', related: 'Related work', readCase: 'Read the case study', faq: 'Questions we get', also: 'Also in every plan',
  },
  de: {
    home: 'Startseite', services: 'Leistungen', breadcrumb: 'Brotkrümelnavigation', audit: 'Kostenlosen Audit buchen', fits: 'So passt es in Ihren Plan',
    plansTitle: 'In jedem Plan enthalten – in unterschiedlichem Umfang.', plansLead: 'Diese Leistung kaufen Sie nicht einzeln. Sie läuft zusammen mit Website, Marketing, Apps und Hosting in einem Monatsplan.',
    perMonth: '/ Monat', compareAll: 'Alle Pläne vergleichen', how: 'So arbeiten wir', step: 'Schritt', tools: 'Unsere Tools',
    screenshot: 'Projekt-Screenshot', related: 'Passendes Projekt', readCase: 'Zur Fallstudie', faq: 'Häufige Fragen', also: 'Ebenfalls in jedem Plan',
  },
}[lang];

const planPrice = (name: string) => plans.plans.find((p) => p.name === name)?.price ?? '';
const planRows = [
  { name: 'Essentials', price: planPrice('Essentials'), text: s.inPlans.essentials },
  { name: 'Growth', price: planPrice('Growth'), text: s.inPlans.growth, featured: true },
  { name: 'Scale', price: planPrice('Scale'), text: s.inPlans.scale },
];

const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: s.title,
    description: s.metaDescription,
    url: pageUrl,
    provider: { '@type': 'ProfessionalService', name: site.name, url: new URL(localize('/', lang), Astro.site).toString() },
    areaServed: 'Europe',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t.home, item: new URL(localize('/', lang), Astro.site).toString() },
      { '@type': 'ListItem', position: 2, name: t.services, item: new URL(localize('/services/', lang), Astro.site).toString() },
      { '@type': 'ListItem', position: 3, name: s.title, item: pageUrl },
    ],
  },
  ...(s.faq.length
    ? [{
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: s.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
      }]
    : []),
];
---

<Base title={s.metaTitle} description={s.metaDescription}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />

  <!-- Hero -->
  <section class="relative overflow-hidden bg-tint">
    <BrandMark variant="blue" class="-bottom-28 -right-16 hidden w-[440px] opacity-[0.05] lg:block" />
    <div class="container-site relative flex flex-col gap-6 py-18 lg:py-22">
      <nav aria-label={t.breadcrumb} class="label text-dim" data-reveal>
        <a href={localize('/services/', lang)} class="text-dim no-underline hover:text-brand">{t.services}</a>
        <span aria-hidden="true" class="mx-2">/</span>
        <span class="text-brand">{s.discipline}</span>
      </nav>
      <h1 class="h-hero max-w-[860px]" data-reveal style="--i:1">{s.heroTitle}</h1>
      <p class="m-0 max-w-[660px] text-[19px] leading-[1.55] text-body" data-reveal style="--i:2">{s.heroText}</p>
      <div class="flex flex-wrap gap-3.5" data-reveal style="--i:3">
        <a href={site.auditUrl} class="btn btn-primary">{t.audit}</a>
        <a href="#plans" class="btn btn-outline">{t.fits}</a>
      </div>
    </div>
  </section>

  <!-- Pains -->
  {s.pains.length > 0 && (
    <section>
      <div class="container-site flex flex-col gap-10 py-22">
        <h2 class="h-section" data-reveal>{s.painsTitle}</h2>
        <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,280px),1fr))] gap-5">
          {s.pains.map((p, i) => (
            <div class="flex flex-col gap-2.5 rounded-[20px] bg-tint-soft p-8" data-reveal style={`--i:${i}`}>
              <h3 class="m-0 text-[19px] font-bold">{p.title}</h3>
              <p class="m-0 text-[15px] leading-[1.6] text-body">{p.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Deliverables -->
  <section class="bg-ink text-white">
    <div class="container-site flex flex-col gap-10 py-22">
      <div class="flex flex-col gap-4" data-reveal>
        <p class="eyebrow m-0 !text-night-accent">{s.title}</p>
        <h2 class="h-section">{s.deliverablesTitle}</h2>
      </div>
      <ul class="m-0 grid list-none grid-cols-[repeat(auto-fit,minmax(min(100%,300px),1fr))] gap-x-10 gap-y-7 p-0">
        {s.deliverables.map((d, i) => (
          <li class="flex gap-4" data-reveal style={`--i:${i % 3}`}>
            <span class="mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-full bg-night-line text-night-accent"><Icon name="check" size={16} /></span>
            <span class="flex flex-col gap-1.5">
              <span class="text-[17px] font-bold">{d.title}</span>
              <span class="text-[15px] leading-[1.6] text-night-text">{d.text}</span>
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- In your plan -->
  <section id="plans" class="bg-tint">
    <div class="container-site flex flex-col gap-10 py-22">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <h2 class="h-section max-w-[620px]" data-reveal>{t.plansTitle}</h2>
        <p class="lead max-w-[440px]" data-reveal style="--i:1">{t.plansLead}</p>
      </div>
      <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,280px),1fr))] gap-5">
        {planRows.map((p, i) => (
          <div class:list={['flex flex-col gap-3 rounded-[20px] p-8', p.featured ? 'bg-ink text-white' : 'bg-white']} data-reveal style={`--i:${i}`}>
            <p class="m-0 flex items-baseline justify-between gap-3">
              <span class="text-[20px] font-extrabold">{p.name}</span>
              <span class:list={['text-[15px] font-semibold', p.featured ? 'text-night-text' : 'text-muted']}>{fromPrice(p.price, lang)} {t.perMonth}</span>
            </p>
            <p class:list={['m-0 text-[15px] leading-[1.6]', p.featured ? 'text-night-text' : 'text-body']}>{p.text}</p>
          </div>
        ))}
      </div>
      <a href={localize('/pricing/', lang)} class="group inline-flex w-fit items-center gap-1.5 font-semibold" data-reveal>{t.compareAll} <Icon name="arrow" size={13} class="shrink-0 transition-transform duration-300 ease-out group-hover:translate-x-0.5" /></a>
    </div>
  </section>

  <!-- How we work -->
  {s.steps.length > 0 && (
    <section>
      <div class="container-site flex flex-col gap-10 py-22">
        <h2 class="h-section" data-reveal>{t.how}</h2>
        <ol class="m-0 grid list-none grid-cols-[repeat(auto-fit,minmax(min(100%,220px),1fr))] gap-5 p-0">
          {s.steps.map((st, i) => (
            <li class="flex flex-col gap-2.5 rounded-2xl bg-tint-soft p-7" data-reveal style={`--i:${i}`}>
              <span class="label text-brand">{t.step} {i + 1}</span>
              <h3 class="m-0 text-[19px] font-bold">{st.title}</h3>
              <p class="m-0 text-[15px] leading-[1.55] text-body">{st.text}</p>
            </li>
          ))}
        </ol>
        {s.tools.length > 0 && (
          <div class="flex flex-wrap items-center gap-x-7 gap-y-3 border-t border-line-soft pt-8" data-reveal>
            <span class="label text-dim">{t.tools}</span>
            {s.tools.map((tool) => <span class="text-[16px] font-bold text-body">{tool}</span>)}
          </div>
        )}
      </div>
    </section>
  )}

  <!-- Related work -->
  {work && (
    <section class="border-t border-line-soft">
      <div class="container-site flex flex-wrap items-center gap-10 py-22">
        <Placeholder label={t.screenshot} src={work.data.image} alt={work.data.imageAlt} class="h-[280px] min-w-0 flex-[1_1_420px] rounded-[20px]" />
        <div class="flex min-w-0 flex-[1_1_420px] flex-col gap-3" data-reveal>
          <p class="eyebrow m-0">{t.related}</p>
          <p class="label m-0 text-dim">{work.data.meta}</p>
          <h2 class="m-0 text-[28px] font-extrabold leading-tight">{work.data.title}</h2>
          <p class="lead">{work.data.summary}</p>
          <a href={localize(`/work/${slugOf(work)}/`, lang)} class="group mt-2 inline-flex w-fit items-center gap-1.5 font-semibold">{t.readCase} <Icon name="arrow" size={13} class="shrink-0 transition-transform duration-300 ease-out group-hover:translate-x-0.5" /></a>
        </div>
      </div>
    </section>
  )}

  <!-- FAQ -->
  {s.faq.length > 0 && (
    <section class="bg-tint-soft">
      <div class="container-site flex flex-wrap gap-12 py-22">
        <h2 class="h-section min-w-0 flex-[1_1_300px]" data-reveal>{t.faq}</h2>
        <div class="flex min-w-0 flex-[2_1_520px] flex-col gap-3">
          {s.faq.map((f) => (
            <details class="faq group rounded-2xl border border-line bg-white px-6 py-5 transition-colors duration-300 hover:border-brand open:border-brand" data-reveal>
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-[17px] font-bold text-ink transition-colors duration-300 hover:text-brand [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-tint text-brand transition-[transform,background-color,color] duration-300 group-hover:bg-brand group-hover:text-white group-open:rotate-45 group-open:bg-brand group-open:text-white" aria-hidden="true">+</span>
              </summary>
              <div class="faq-body overflow-hidden"><p class="m-0 pt-3 text-[15px] leading-[1.65] text-body">{f.a}</p></div>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Other services -->
  <section>
    <div class="container-site flex flex-col gap-6 py-18">
      <p class="label m-0 text-dim">{t.also}</p>
      <ul class="m-0 grid list-none grid-cols-[repeat(auto-fit,minmax(min(100%,220px),1fr))] gap-4 p-0">
        {others.map((o) => (
          <li>
            <a href={localize(`/services/${slugOf(o)}/`, lang)} class="card-hover group flex h-full flex-col gap-2 rounded-2xl border border-line bg-white p-6 no-underline">
              <span class="label text-brand">{o.data.discipline}</span>
              <span class="flex items-center justify-between gap-3 text-[17px] font-bold text-ink">
                {o.data.title}
                <Icon name="arrow" size={18} class="shrink-0 text-brand transition-transform duration-300 ease-out group-hover:translate-x-1" />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Contact />
</Base>
