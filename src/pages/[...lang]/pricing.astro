---
import Base from '../../layouts/Base.astro';
import BrandMark from '../../components/BrandMark.astro';
import Icon from '../../components/Icon.astro';
import PlanCards from '../../components/PlanCards.astro';
import Contact from '../../components/sections/Contact.astro';
import { getPlans, getPricing, getSite } from '../../i18n/data';
import { fromPrice, getLang, langParams } from '../../i18n';

export function getStaticPaths() {
  return langParams();
}

const lang = getLang(Astro.url);
const plans = getPlans(lang);
const pricing = getPricing(lang);
const site = getSite(lang);

const cols = plans.plans.filter((p) => p.name !== 'Custom');
const terms = pricing.terms.map((t) => ({ ...t, text: t.text.replace('{discount}', String(pricing.annualDiscount)) }));

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: pricing.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

const t = {
  en: {
    metaTitle: 'Pricing — Monthly Plans for Web, Marketing, CRM & Hosting | Upnestly',
    metaDescription: `Monthly plans from ${cols[0]?.price} — website, marketing, CRM and automation, and managed hosting from one senior team. Priced by result, not hours.`,
    eyebrow: 'Pricing', title: 'Simple monthly plans. One senior team.', text: 'Every plan includes your website, marketing, processes and hosting. Priced by result, not hours — the exact price follows a free discovery call.',
    compare: 'Compare plans in detail', caption: 'Feature comparison of the Essentials, Growth and Scale plans', feature: 'Feature', perMonth: '/ month', included: 'Included', notIncluded: 'Not included',
    hoursTitle: 'What a month can look like', hoursLead: 'Examples of what one month brings in each plan — across website, marketing and processes.',
    addonsTitle: 'Bigger projects, next to your plan', addonsLead: 'Larger pieces of work run as a fixed-price project — scoped up front, then maintained through your monthly plan.',
    billing: 'How billing works', faq: 'Pricing questions', faqLead: 'Not sure which plan fits? Book the free audit and we’ll recommend one.', audit: 'Book a free audit',
  },
  de: {
    metaTitle: 'Preise — Monatspläne für Web, Marketing, CRM & Hosting | Upnestly',
    metaDescription: `Monatspläne ab ${cols[0]?.price} – Website, Marketing, CRM und Automatisierung sowie Managed Hosting aus einem Senior-Team. Preis nach Ergebnis, nicht nach Stunden.`,
    eyebrow: 'Preise', title: 'Einfache Monatspläne. Ein Senior-Team.', text: 'Jeder Plan umfasst Website, Marketing, Prozesse und Hosting. Preis nach Ergebnis, nicht nach Stunden – der genaue Preis folgt nach einem kostenlosen Analysegespräch.',
    compare: 'Pläne im Detail vergleichen', caption: 'Leistungsvergleich der Pläne Essentials, Growth und Scale', feature: 'Leistung', perMonth: '/ Monat', included: 'Enthalten', notIncluded: 'Nicht enthalten',
    hoursTitle: 'So kann ein Monat aussehen', hoursLead: 'Beispiele, was ein Monat in jedem Plan bringt – über Website, Marketing und Prozesse hinweg.',
    addonsTitle: 'Größere Projekte neben Ihrem Plan', addonsLead: 'Größere Vorhaben laufen als Festpreisprojekt – vorab definiert und danach über Ihren Monatsplan betreut.',
    billing: 'So funktioniert die Abrechnung', faq: 'Fragen zu den Preisen', faqLead: 'Unsicher, welcher Plan passt? Buchen Sie den kostenlosen Audit – wir empfehlen Ihnen einen.', audit: 'Kostenlosen Audit buchen',
  },
}[lang];
---

<Base title={t.metaTitle} description={t.metaDescription}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Hero + plans -->
  <section class="relative overflow-hidden bg-tint">
    <BrandMark variant="blue" class="-right-16 -top-24 hidden w-[440px] opacity-[0.05] lg:block" />
    <div class="container-site relative flex flex-col gap-12 py-18 lg:py-22">
      <div class="flex flex-col gap-6">
        <p class="eyebrow m-0" data-reveal>{t.eyebrow}</p>
        <h1 class="h-hero max-w-[860px]" data-reveal style="--i:1">{t.title}</h1>
        <p class="m-0 max-w-[660px] text-[19px] leading-[1.55] text-body" data-reveal style="--i:2">
          {t.text}
        </p>
      </div>
      <PlanCards toggle />
    </div>
  </section>

  <!-- Compare -->
  <section id="compare">
    <div class="container-site flex flex-col gap-10 py-22">
      <h2 class="h-section" data-reveal>{t.compare}</h2>
      <div class="overflow-x-auto rounded-[20px] border border-line" data-reveal>
        <table class="w-full min-w-[760px] border-collapse text-left text-[15px]">
          <caption class="sr-only">{t.caption}</caption>
          <thead>
            <tr class="border-b border-line">
              <th scope="col" class="w-[34%] p-6"><span class="sr-only">{t.feature}</span></th>
              {cols.map((p) => (
                <th scope="col" class:list={['p-6 align-bottom', p.featured && 'bg-tint-soft']}>
                  <span class="block text-[19px] font-extrabold text-ink">{p.name}</span>
                  <span class="text-[14px] font-semibold text-muted">{fromPrice(p.price, lang)} {t.perMonth}</span>
                </th>
              ))}
            </tr>
          </thead>
          {pricing.compare.map((group) => (
            <tbody>
              <tr class="border-b border-line-soft bg-tint">
                <th scope="colgroup" colspan={cols.length + 1} class="px-6 py-3"><span class="label text-brand">{group.group}</span></th>
              </tr>
              {group.rows.map((row) => (
                <tr class="border-b border-line-soft">
                  <th scope="row" class="px-6 py-4 font-semibold text-ink">{row.label}</th>
                  {row.values.map((v, i) => (
                    <td class:list={['px-6 py-4 text-body', cols[i]?.featured && 'bg-tint-soft']}>
                      {v === true ? (
                        <span class="inline-flex size-7 items-center justify-center rounded-full bg-tint text-brand"><Icon name="check" size={15} /><span class="sr-only">{t.included}</span></span>
                      ) : v === false ? (
                        <span class="text-dim" aria-label={t.notIncluded}>—</span>
                      ) : (
                        <span class="font-semibold text-ink">{v}</span>
                      )}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          ))}
        </table>
      </div>
    </div>
  </section>

  <!-- What hours buy -->
  <section class="bg-tint-soft">
    <div class="container-site flex flex-col gap-10 py-22">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <h2 class="h-section max-w-[620px]" data-reveal>{t.hoursTitle}</h2>
        <p class="lead max-w-[440px]" data-reveal style="--i:1">{t.hoursLead}</p>
      </div>
      <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,280px),1fr))] gap-5">
        {pricing.examples.map((e, i) => (
          <div class="flex flex-col gap-3 rounded-[20px] bg-white p-8" data-reveal style={`--i:${i}`}>
            <p class="m-0 flex flex-col gap-2">
              <span class="label text-brand">{e.plan}</span>
              <span class="text-[20px] font-extrabold leading-tight text-ink">{e.title}</span>
            </p>
            <p class="m-0 text-[15px] leading-[1.6] text-body">{e.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Add-ons -->
  <section>
    <div class="container-site flex flex-col gap-10 py-22">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <h2 class="h-section max-w-[620px]" data-reveal>{t.addonsTitle}</h2>
        <p class="lead max-w-[440px]" data-reveal style="--i:1">{t.addonsLead}</p>
      </div>
      <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,280px),1fr))] gap-5">
        {pricing.addons.map((a, i) => (
          <div class="flex flex-col gap-3 rounded-[20px] border border-line p-8" data-reveal style={`--i:${i}`}>
            <h3 class="m-0 text-[19px] font-bold">{a.title}</h3>
            <p class="m-0 flex items-baseline gap-2">
              <span class="text-[24px] font-extrabold leading-none tracking-[-0.01em] text-brand">{a.price}</span>
              <span class="text-[15px] text-muted">{a.unit}</span>
            </p>
            <p class="m-0 text-[15px] leading-[1.6] text-body">{a.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Billing terms -->
  <section class="bg-ink text-white">
    <div class="container-site flex flex-col gap-10 py-22">
      <h2 class="h-section" data-reveal>{t.billing}</h2>
      <ul class="m-0 grid list-none grid-cols-[repeat(auto-fit,minmax(min(100%,300px),1fr))] gap-x-10 gap-y-7 p-0">
        {terms.map((term, i) => (
          <li class="flex gap-4" data-reveal style={`--i:${i % 3}`}>
            <span class="mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-full bg-night-line text-night-accent"><Icon name="check" size={16} /></span>
            <span class="flex flex-col gap-1.5">
              <span class="text-[17px] font-bold">{term.title}</span>
              <span class="text-[15px] leading-[1.6] text-night-text">{term.text}</span>
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-tint-soft">
    <div class="container-site flex flex-wrap gap-12 py-22">
      <div class="flex min-w-0 flex-[1_1_300px] flex-col gap-5" data-reveal>
        <h2 class="h-section">{t.faq}</h2>
        <p class="lead">{t.faqLead}</p>
        <a href={site.auditUrl} class="btn btn-primary w-fit">{t.audit}</a>
      </div>
      <div class="flex min-w-0 flex-[2_1_520px] flex-col gap-3">
        {pricing.faq.map((f) => (
          <details class="faq group rounded-2xl border border-line bg-white px-6 py-5 transition-colors duration-300 hover:border-brand open:border-brand" data-reveal>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-[17px] font-bold text-ink transition-colors duration-300 hover:text-brand [&::-webkit-details-marker]:hidden">
              {f.q}
              <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-tint text-brand transition-[transform,background-color,color] duration-300 group-hover:bg-brand group-hover:text-white group-open:rotate-45 group-open:bg-brand group-open:text-white" aria-hidden="true">+</span>
            </summary>
            <div class="faq-body overflow-hidden"><p class="m-0 pt-3 text-[15px] leading-[1.65] text-body">{f.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <div class="h-24"></div>
  <Contact />
</Base>
