---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import BrandMark from '../../components/BrandMark.astro';
import Icon from '../../components/Icon.astro';
import SavingsCalculator from '../../components/SavingsCalculator.astro';
import Contact from '../../components/sections/Contact.astro';
import ai from '../../data/ai.json';
import plans from '../../data/plans.json';
import site from '../../data/site.json';

const entry = await getEntry('services', 'ai-automation');
const others = (await getCollection('services'))
  .filter((o) => o.id !== 'ai-automation')
  .sort((a, b) => a.data.order - b.data.order);

const checkHref = site.auditUrl.startsWith('mailto:')
  ? `mailto:${site.email}?subject=${encodeURIComponent('AI opportunity check')}`
  : site.auditUrl;
const quoteHref = site.auditUrl.startsWith('mailto:')
  ? `mailto:${site.email}?subject=${encodeURIComponent('Custom AI project')}`
  : site.auditUrl;
const price = (name: string) => plans.plans.find((p) => p.name === name)?.price ?? '';

const principles = [
  { title: 'Human-reviewed', text: 'Nothing generated goes live without an editor’s sign-off.' },
  { title: 'GDPR-aware', text: 'EU hosting options and documented data flows for every workflow.' },
  { title: 'Measured', text: 'Hours saved and output volume tracked from day one.' },
  { title: 'Yours to keep', text: 'Workflows documented and handed over, no lock-in.' },
];

const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'AI automation',
    description: entry?.data.metaDescription,
    url: pageUrl,
    provider: { '@type': 'ProfessionalService', name: site.name, url: Astro.site?.toString() },
    areaServed: 'Europe',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
      { '@type': 'ListItem', position: 2, name: 'Services', item: new URL('/services/', Astro.site).toString() },
      { '@type': 'ListItem', position: 3, name: 'AI automation', item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: ai.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---

<Base title={entry?.data.metaTitle ?? 'AI Automation | Upnestly'} description={entry?.data.metaDescription}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />

  <!-- Hero -->
  <section class="relative overflow-hidden bg-ink text-white">
    <BrandMark class="-bottom-40 -right-32 w-[640px] opacity-[0.06]" />
    <div class="container-site relative flex flex-col gap-6 py-20 lg:py-26">
      <nav aria-label="Breadcrumb" class="label text-night-text" data-reveal>
        <a href="/services/" class="text-night-text no-underline hover:text-white">Services</a>
        <span aria-hidden="true" class="mx-2">/</span>
        <span class="text-night-accent">AI automation</span>
      </nav>
      <h1 class="m-0 max-w-[900px] font-extrabold leading-[1.04] tracking-[-0.03em]" style="font-size: clamp(40px, 5.2vw, 64px); --i:1" data-reveal>
        Put AI to work on the busywork — not on your brand.
      </h1>
      <p class="m-0 max-w-[680px] text-[19px] leading-[1.55] text-night-text" data-reveal style="--i:2">
        Catalogue enrichment, content, lead handling and reporting — automated with LLMs and n8n, with a human checkpoint before anything goes live.
      </p>
      <div class="flex flex-wrap gap-3.5" data-reveal style="--i:3">
        <a href={checkHref} class="btn btn-light">Free AI opportunity check</a>
        <a href="#use-cases" class="btn border border-night-line text-white hover:text-white">See where it pays off</a>
      </div>
    </div>
  </section>

  <!-- Use cases -->
  <section id="use-cases">
    <div class="container-site flex flex-col gap-10 py-22">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <h2 class="h-section max-w-[620px]" data-reveal>Where AI pays off first</h2>
        <p class="lead max-w-[440px]" data-reveal style="--i:1">Repetitive work with clear inputs and a clear result. That’s where automation saves hours without risking quality.</p>
      </div>
      <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,300px),1fr))] gap-5">
        {ai.useCases.map((u, i) => (
          <article class="flex flex-col gap-3 rounded-[20px] border border-line p-8" data-reveal style={`--i:${i % 3}`}>
            <p class="label m-0 text-brand">{u.tag}</p>
            <h3 class="m-0 text-[21px] font-extrabold">{u.title}</h3>
            <p class="m-0 text-[15px] leading-[1.6] text-body">{u.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Pipeline -->
  <section class="bg-tint">
    <div class="container-site flex flex-col gap-10 py-22">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div class="flex max-w-[640px] flex-col gap-4" data-reveal>
          <p class="eyebrow m-0">How a pipeline works</p>
          <h2 class="h-section">From supplier spreadsheet to live product pages</h2>
        </div>
        <p class="lead max-w-[440px]" data-reveal style="--i:1">A real workflow from a 650-product outdoor shop. The human step is not optional — it’s the part that keeps quality up.</p>
      </div>

      <ol class="m-0 grid list-none grid-cols-1 gap-3 p-0 md:grid-cols-5 md:gap-0">
        {ai.pipeline.map((p, i) => (
          <li class="relative flex md:flex-col" data-reveal style={`--i:${i}`}>
            <div class:list={['flex flex-1 flex-col gap-2 rounded-[18px] p-6 md:mr-6', p.human ? 'bg-brand text-white' : 'bg-white']}>
              <span class:list={['label', p.human ? 'text-night-accent' : 'text-brand']}>{String(i + 1).padStart(2, '0')}</span>
              <span class="text-[18px] font-extrabold">{p.step}</span>
              <span class:list={['text-[14px] leading-[1.55]', p.human ? 'text-night-text' : 'text-body']}>{p.text}</span>
            </div>
            {i < ai.pipeline.length - 1 && (
              <span class="absolute right-0 top-1/2 hidden -translate-y-1/2 text-brand md:block" aria-hidden="true"><Icon name="arrow" size={20} /></span>
            )}
          </li>
        ))}
      </ol>

      <div class="flex flex-wrap items-center gap-x-10 gap-y-4 rounded-[20px] border border-line bg-white p-7" data-reveal>
        <p class="label m-0 text-dim">Result</p>
        <p class="m-0 flex-[1_1_480px] text-[16px] leading-[1.6] text-body">
          <strong class="text-ink">650 products</strong> with descriptions, translations and SEO fields. {ai.result}
        </p>
        <a href="/#work" class="shrink-0 font-semibold">See the project →</a>
      </div>
    </div>
  </section>

  <!-- Principles -->
  <section class="bg-ink text-white">
    <div class="container-site flex flex-wrap gap-14 py-22">
      <div class="flex min-w-0 flex-[1_1_380px] flex-col gap-4" data-reveal>
        <p class="eyebrow m-0 !text-night-accent">How we build</p>
        <h2 class="h-section">AI does the volume. People own the result.</h2>
      </div>
      <div class="grid min-w-0 flex-[1_1_520px] grid-cols-[repeat(auto-fit,minmax(230px,1fr))] gap-4">
        {principles.map((p, i) => (
          <div class="flex flex-col gap-2 rounded-2xl border border-night-line p-6" data-reveal style={`--i:${i}`}>
            <h3 class="m-0 text-[18px] font-bold">{p.title}</h3>
            <p class="m-0 text-[15px] leading-[1.55] text-night-text">{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Calculator -->
  <section class="bg-tint">
    <div class="container-site flex flex-col gap-10 py-22">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <h2 class="h-section max-w-[620px]" data-reveal>What could one automation be worth?</h2>
        <p class="lead max-w-[440px]" data-reveal style="--i:1">Pick a task your team repeats every week and move the sliders.</p>
      </div>
      <div data-reveal><SavingsCalculator /></div>
    </div>
  </section>

  <!-- Ways to buy -->
  <section>
    <div class="container-site flex flex-col gap-10 py-22">
      <h2 class="h-section" data-reveal>Two ways to get started</h2>
      <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,340px),1fr))] gap-5">
        <article class="flex flex-col gap-5 rounded-[20px] bg-tint-soft p-9" data-reveal>
          <p class="label m-0 text-brand">Inside your plan</p>
          <h3 class="m-0 text-[26px] font-extrabold leading-tight">Smaller automations, in your monthly hours</h3>
          <p class="m-0 text-[15px] leading-[1.6] text-body">Lead routing, reporting, content drafts and similar workflows run on the development hours of your plan.</p>
          <ul class="m-0 flex list-none flex-col gap-2 p-0 text-[15px]">
            <li class="flex gap-2.5"><Icon name="check" size={16} class="mt-0.5 shrink-0 text-brand" /><span><strong>Growth</strong> ({price('Growth')}/month): AI automations within 16 h</span></li>
            <li class="flex gap-2.5"><Icon name="check" size={16} class="mt-0.5 shrink-0 text-brand" /><span><strong>Scale</strong> ({price('Scale')}/month): larger workflows within 32 h, planned quarterly</span></li>
          </ul>
          <a href="/pricing/" class="btn btn-primary mt-auto w-fit">See plans</a>
        </article>
        <article class="flex flex-col gap-5 rounded-[20px] border-2 border-brand p-9" data-reveal style="--i:1">
          <p class="label m-0 text-brand">Custom AI project</p>
          <h3 class="m-0 text-[26px] font-extrabold leading-tight">Bigger pipelines, at a fixed price</h3>
          <p class="m-0 text-[15px] leading-[1.6] text-body">Catalogue pipelines, document processing and multi-system integrations, scoped and quoted up front. After launch, the workflow is maintained through a monthly plan.</p>
          <p class="m-0 flex items-baseline gap-2">
            <span class="text-[15px] text-muted">From</span>
            <span class="text-[36px] font-extrabold leading-none tracking-[-0.02em] text-ink">{ai.customFrom}</span>
          </p>
          <a href={quoteHref} class="btn btn-outline mt-auto w-fit">Get a quote</a>
        </article>
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="bg-tint-soft">
    <div class="container-site flex flex-col gap-10 py-22">
      <h2 class="h-section" data-reveal>From idea to running workflow</h2>
      <ol class="m-0 grid list-none grid-cols-[repeat(auto-fit,minmax(min(100%,220px),1fr))] gap-5 p-0">
        {ai.process.map((s, i) => (
          <li class="flex flex-col gap-2.5 rounded-2xl bg-white p-7" data-reveal style={`--i:${i}`}>
            <span class="label text-brand">Step {i + 1}</span>
            <h3 class="m-0 text-[19px] font-bold">{s.title}</h3>
            <p class="m-0 text-[15px] leading-[1.55] text-body">{s.text}</p>
          </li>
        ))}
      </ol>
      <div class="flex flex-wrap items-center gap-x-7 gap-y-3 border-t border-line pt-8" data-reveal>
        <span class="label text-dim">Tools we use</span>
        {ai.tools.map((t) => <span class="text-[16px] font-bold text-body">{t}</span>)}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section>
    <div class="container-site flex flex-wrap gap-12 py-22">
      <div class="flex min-w-0 flex-[1_1_300px] flex-col gap-5" data-reveal>
        <h2 class="h-section">Questions we get</h2>
        <p class="lead">Have a process in mind? We’ll tell you honestly whether it’s worth automating.</p>
        <a href={checkHref} class="btn btn-primary w-fit">Free AI opportunity check</a>
      </div>
      <div class="flex min-w-0 flex-[2_1_520px] flex-col gap-3">
        {ai.faq.map((f) => (
          <details class="group rounded-2xl border border-line bg-white px-6 py-5" data-reveal>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-[17px] font-bold text-ink [&::-webkit-details-marker]:hidden">
              {f.q}
              <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-tint text-brand transition-transform group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="m-0 mt-3 text-[15px] leading-[1.65] text-body">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Other services -->
  <section class="border-t border-line-soft">
    <div class="container-site flex flex-col gap-6 py-18">
      <p class="label m-0 text-dim">Also in every plan</p>
      <ul class="m-0 grid list-none grid-cols-[repeat(auto-fit,minmax(min(100%,220px),1fr))] gap-4 p-0">
        {others.map((o) => (
          <li>
            <a href={`/services/${o.id}/`} class="group flex h-full flex-col gap-2 rounded-2xl border border-line p-6 no-underline hover:border-brand">
              <span class="label text-brand">{o.data.discipline}</span>
              <span class="flex items-center justify-between gap-3 text-[17px] font-bold text-ink">
                {o.data.title}
                <Icon name="arrow" size={18} class="shrink-0 text-brand transition-transform group-hover:translate-x-1" />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Contact />
</Base>
