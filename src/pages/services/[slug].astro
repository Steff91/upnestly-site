---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import BrandMark from '../../components/BrandMark.astro';
import Icon from '../../components/Icon.astro';
import Placeholder from '../../components/Placeholder.astro';
import Contact from '../../components/sections/Contact.astro';
import site from '../../data/site.json';
import plans from '../../data/plans.json';

export async function getStaticPaths() {
  // AI automation has its own page (src/pages/services/ai-automation.astro); its .md still feeds the hub cards and plan table.
  const services = (await getCollection('services')).filter((s) => s.id !== 'ai-automation');
  return services.map((service) => ({ params: { slug: service.id }, props: { service } }));
}

const { service } = Astro.props;
const s = service.data;
const work = s.relatedWork ? await getEntry('work', s.relatedWork) : undefined;
const others = (await getCollection('services'))
  .filter((o) => o.id !== service.id)
  .sort((a, b) => a.data.order - b.data.order);

const planPrice = (name: string) => plans.plans.find((p) => p.name === name)?.price ?? '';
const planRows = [
  { name: 'Essentials', price: planPrice('Essentials'), text: s.inPlans.essentials },
  { name: 'Growth', price: planPrice('Growth'), text: s.inPlans.growth, featured: true },
  { name: 'Scale', price: planPrice('Scale'), text: s.inPlans.scale },
];

const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: s.title,
    description: s.metaDescription,
    url: pageUrl,
    provider: { '@type': 'ProfessionalService', name: site.name, url: Astro.site?.toString() },
    areaServed: 'Europe',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
      { '@type': 'ListItem', position: 2, name: 'Services', item: new URL('/services/', Astro.site).toString() },
      { '@type': 'ListItem', position: 3, name: s.title, item: pageUrl },
    ],
  },
  ...(s.faq.length
    ? [{
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: s.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
      }]
    : []),
];
---

<Base title={s.metaTitle} description={s.metaDescription}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />

  <!-- Hero -->
  <section class="relative overflow-hidden bg-tint">
    <BrandMark variant="blue" class="-bottom-48 -right-24 hidden w-[600px] opacity-[0.07] lg:block" />
    <div class="container-site relative flex flex-col gap-6 py-18 lg:py-22">
      <nav aria-label="Breadcrumb" class="label text-dim" data-reveal>
        <a href="/services/" class="text-dim no-underline hover:text-brand">Services</a>
        <span aria-hidden="true" class="mx-2">/</span>
        <span class="text-brand">{s.discipline}</span>
      </nav>
      <h1 class="h-hero max-w-[860px]" data-reveal style="--i:1">{s.heroTitle}</h1>
      <p class="m-0 max-w-[660px] text-[19px] leading-[1.55] text-body" data-reveal style="--i:2">{s.heroText}</p>
      <div class="flex flex-wrap gap-3.5" data-reveal style="--i:3">
        <a href={site.auditUrl} class="btn btn-primary">Book a free audit</a>
        <a href="#plans" class="btn btn-outline">How it fits your plan</a>
      </div>
    </div>
  </section>

  <!-- Pains -->
  {s.pains.length > 0 && (
    <section>
      <div class="container-site flex flex-col gap-10 py-22">
        <h2 class="h-section" data-reveal>{s.painsTitle}</h2>
        <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,280px),1fr))] gap-5">
          {s.pains.map((p, i) => (
            <div class="flex flex-col gap-2.5 rounded-[20px] bg-tint-soft p-8" data-reveal style={`--i:${i}`}>
              <h3 class="m-0 text-[19px] font-bold">{p.title}</h3>
              <p class="m-0 text-[15px] leading-[1.6] text-body">{p.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Deliverables -->
  <section class="bg-ink text-white">
    <div class="container-site flex flex-col gap-10 py-22">
      <div class="flex flex-col gap-4" data-reveal>
        <p class="eyebrow m-0 !text-night-accent">{s.title}</p>
        <h2 class="h-section">{s.deliverablesTitle}</h2>
      </div>
      <ul class="m-0 grid list-none grid-cols-[repeat(auto-fit,minmax(min(100%,300px),1fr))] gap-x-10 gap-y-7 p-0">
        {s.deliverables.map((d, i) => (
          <li class="flex gap-4" data-reveal style={`--i:${i % 3}`}>
            <span class="mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-full bg-night-line text-night-accent"><Icon name="check" size={16} /></span>
            <span class="flex flex-col gap-1.5">
              <span class="text-[17px] font-bold">{d.title}</span>
              <span class="text-[15px] leading-[1.6] text-night-text">{d.text}</span>
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- In your plan -->
  <section id="plans" class="bg-tint">
    <div class="container-site flex flex-col gap-10 py-22">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <h2 class="h-section max-w-[620px]" data-reveal>Included in every plan — at a different pace.</h2>
        <p class="lead max-w-[440px]" data-reveal style="--i:1">You don’t buy this on its own. It runs alongside development, growth and hosting on one monthly plan.</p>
      </div>
      <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,280px),1fr))] gap-5">
        {planRows.map((p, i) => (
          <div class:list={['flex flex-col gap-3 rounded-[20px] p-8', p.featured ? 'bg-ink text-white' : 'bg-white']} data-reveal style={`--i:${i}`}>
            <p class="m-0 flex items-baseline justify-between gap-3">
              <span class="text-[20px] font-extrabold">{p.name}</span>
              <span class:list={['text-[15px] font-semibold', p.featured ? 'text-night-text' : 'text-muted']}>{p.price} / month</span>
            </p>
            <p class:list={['m-0 text-[15px] leading-[1.6]', p.featured ? 'text-night-text' : 'text-body']}>{p.text}</p>
          </div>
        ))}
      </div>
      <a href="/pricing/" class="w-fit font-semibold" data-reveal>Compare all plans →</a>
    </div>
  </section>

  <!-- How we work -->
  {s.steps.length > 0 && (
    <section>
      <div class="container-site flex flex-col gap-10 py-22">
        <h2 class="h-section" data-reveal>How we work</h2>
        <ol class="m-0 grid list-none grid-cols-[repeat(auto-fit,minmax(min(100%,220px),1fr))] gap-5 p-0">
          {s.steps.map((st, i) => (
            <li class="flex flex-col gap-2.5 rounded-2xl bg-tint-soft p-7" data-reveal style={`--i:${i}`}>
              <span class="label text-brand">Step {i + 1}</span>
              <h3 class="m-0 text-[19px] font-bold">{st.title}</h3>
              <p class="m-0 text-[15px] leading-[1.55] text-body">{st.text}</p>
            </li>
          ))}
        </ol>
        {s.tools.length > 0 && (
          <div class="flex flex-wrap items-center gap-x-7 gap-y-3 border-t border-line-soft pt-8" data-reveal>
            <span class="label text-dim">Tools we use</span>
            {s.tools.map((t) => <span class="text-[16px] font-bold text-body">{t}</span>)}
          </div>
        )}
      </div>
    </section>
  )}

  <!-- Related work -->
  {work && (
    <section class="border-t border-line-soft">
      <div class="container-site flex flex-wrap items-center gap-10 py-22">
        <Placeholder label="Project screenshot" src={work.data.image} alt={work.data.imageAlt} class="h-[280px] min-w-0 flex-[1_1_420px] rounded-[20px]" />
        <div class="flex min-w-0 flex-[1_1_420px] flex-col gap-3" data-reveal>
          <p class="eyebrow m-0">Related work</p>
          <p class="label m-0 text-dim">{work.data.meta}</p>
          <h2 class="m-0 text-[28px] font-extrabold leading-tight">{work.data.title}</h2>
          <p class="lead">{work.data.summary}</p>
          <a href={`/work/${work.id}/`} class="mt-2 w-fit font-semibold">Read the case study →</a>
        </div>
      </div>
    </section>
  )}

  <!-- FAQ -->
  {s.faq.length > 0 && (
    <section class="bg-tint-soft">
      <div class="container-site flex flex-wrap gap-12 py-22">
        <h2 class="h-section min-w-0 flex-[1_1_300px]" data-reveal>Questions we get</h2>
        <div class="flex min-w-0 flex-[2_1_520px] flex-col gap-3">
          {s.faq.map((f) => (
            <details class="group rounded-2xl border border-line bg-white px-6 py-5" data-reveal>
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-[17px] font-bold text-ink [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-tint text-brand transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="m-0 mt-3 text-[15px] leading-[1.65] text-body">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Other services -->
  <section>
    <div class="container-site flex flex-col gap-6 py-18">
      <p class="label m-0 text-dim">Also in every plan</p>
      <ul class="m-0 grid list-none grid-cols-[repeat(auto-fit,minmax(min(100%,220px),1fr))] gap-4 p-0">
        {others.map((o) => (
          <li>
            <a href={`/services/${o.id}/`} class="group flex h-full flex-col gap-2 rounded-2xl border border-line p-6 no-underline hover:border-brand">
              <span class="label text-brand">{o.data.discipline}</span>
              <span class="flex items-center justify-between gap-3 text-[17px] font-bold text-ink">
                {o.data.title}
                <Icon name="arrow" size={18} class="shrink-0 text-brand transition-transform group-hover:translate-x-1" />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Contact />
</Base>
