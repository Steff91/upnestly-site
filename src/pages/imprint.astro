---
// Imprint / Impressum. Company details come from src/data/site.json (CMS → Settings → Site & contact).
import Legal from '../layouts/Legal.astro';
import site from '../data/site.json';
---

<Legal
  title="Imprint / Impressum"
  description="Legal information about Upnestly: company details, registration, VAT ID and responsible person."
  updated="[DATE]"
  noindex
>
  <blockquote>
    <p><strong>Example text.</strong> Replace everything in [brackets] and have the imprint checked against the requirements of your target markets (e.g. § 5 DDG in Germany, § 5 ECG in Austria) before the site goes live.</p>
  </blockquote>

  <h2>Company</h2>
  <dl>
    <dt>Company name</dt>
    <dd>{site.legalName}</dd>
    <dt>Address</dt>
    <dd>{site.address}<br />{site.postalCode} {site.city}<br />{site.country}</dd>
    <dt>Represented by</dt>
    <dd>{site.representedBy}</dd>
  </dl>

  <h2>Contact</h2>
  <dl>
    <dt>Email</dt>
    <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
    <dt>Phone</dt>
    <dd>{site.phone}</dd>
  </dl>

  <h2>Registration</h2>
  <dl>
    <dt>Register</dt>
    <dd>{site.register}</dd>
    <dt>Registration number (MB)</dt>
    <dd>{site.registrationNumber}</dd>
    <dt>Tax / VAT ID (PIB)</dt>
    <dd>{site.vatId}</dd>
  </dl>

  <h2>Responsible for content</h2>
  <p>{site.responsiblePerson}, address as above.</p>

  <h2>Consumer dispute resolution</h2>
  <p>[Example:] We are not obliged and not willing to take part in dispute resolution proceedings before a consumer arbitration board. Our services are aimed at businesses.</p>

  <h2>Liability for content</h2>
  <p>We create the content of this website with care, but cannot guarantee that it is complete, correct and up to date at all times. [Example text — adjust to your legal advice.]</p>

  <h2>Liability for links</h2>
  <p>This website contains links to external websites. We have no influence on their content and accept no liability for it. The respective provider is always responsible for the content of linked pages. If we become aware of unlawful content, we will remove the link promptly.</p>

  <h2>Copyright</h2>
  <p>Texts, images, graphics and the Upnestly logo on this website are protected by copyright. Copying or using them requires our prior written permission, unless the law allows otherwise. Case study materials are shown with the permission of our clients.</p>
</Legal>
