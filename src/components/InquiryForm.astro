---
// Inquiry form used on /audit/ and /contact/.
// - Preselects the interest from ?plan=… (falls back to `preset`), and billing from ?billing=annual.
// - Posts to site.formAction (e.g. a Formspree / Web3Forms endpoint) when set.
//   Until then it opens the visitor's email app with everything prefilled, so no enquiry is lost.
import { interestOptions, billablePlans, platformOptions } from '../data/inquiry';
import { getSite, getPricing } from '../i18n/data';
import { getLang, localize } from '../i18n';

interface Props {
  preset?: string;
  submitLabel?: string;
}
const lang = getLang(Astro.url);
const site = getSite(lang);
const pricing = getPricing(lang);
const t = {
  en: {
    interest: 'What are you interested in?', billing: 'Billing', monthly: 'Monthly', annual: `Annual — save ${pricing.annualDiscount}%`,
    name: 'Name', email: 'Work email', company: 'Company', website: 'Website', websitePh: 'example.com',
    platform: 'Platform', platformPh: 'Select a platform', message: 'What would you like to improve?',
    messagePh: 'More leads from the site, a faster shop, automating product data…', honeypot: 'Leave this empty',
    consent: ['I agree that Upnestly may use these details to reply to my enquiry. See the ', 'privacy policy', '.'], send: 'Send',
    mail: { interest: 'Interest', billing: 'Billing', name: 'Name', email: 'Email', company: 'Company', website: 'Website', platform: 'Platform', monthly: 'monthly', annual: 'annual' },
  },
  de: {
    interest: 'Wofür interessieren Sie sich?', billing: 'Abrechnung', monthly: 'Monatlich', annual: `Jährlich – ${pricing.annualDiscount} % sparen`,
    name: 'Name', email: 'Geschäftliche E-Mail', company: 'Unternehmen', website: 'Website', websitePh: 'beispiel.de',
    platform: 'Plattform', platformPh: 'Plattform auswählen', message: 'Was möchten Sie verbessern?',
    messagePh: 'Mehr Leads über die Website, ein schnellerer Shop, automatisierte Produktdaten …', honeypot: 'Bitte leer lassen',
    consent: ['Ich bin einverstanden, dass Upnestly diese Angaben zur Beantwortung meiner Anfrage verwendet. Siehe ', 'Datenschutzerklärung', '.'], send: 'Senden',
    mail: { interest: 'Interesse', billing: 'Abrechnung', name: 'Name', email: 'E-Mail', company: 'Unternehmen', website: 'Website', platform: 'Plattform', monthly: 'monatlich', annual: 'jährlich' },
  },
}[lang];
const { preset = 'audit', submitLabel = t.send } = Astro.props;
const field = 'w-full rounded-xl border border-line bg-white px-4 py-3 text-[16px] text-ink outline-none transition-colors focus:border-brand';
const labelCls = 'text-[14px] font-semibold text-ink';
---

<form
  class="inquiry-form flex flex-col gap-5"
  method="post"
  action={site.formAction || undefined}
  data-preset={preset}
  data-billable={billablePlans.join(' ')}
  data-email={site.email}
  data-thanks={localize('/thank-you/', lang)}
  data-mail={JSON.stringify(t.mail)}
>
  <div class="flex flex-col gap-2">
    <label for="f-interest" class={labelCls}>{t.interest}</label>
    <select id="f-interest" name="interest" class={field} required>
      {interestOptions(lang).map((o) => <option value={o.value} selected={o.value === preset}>{o.label}</option>)}
    </select>
  </div>

  <fieldset class="billing-field m-0 flex flex-col gap-2 border-0 p-0" hidden>
    <legend class:list={[labelCls, 'mb-2']}>{t.billing}</legend>
    <div class="flex flex-wrap gap-2">
      <label class="cursor-pointer">
        <input type="radio" name="billing" value="monthly" checked class="peer sr-only" />
        <span class="inline-flex min-h-11 items-center rounded-full border border-line bg-white px-5 text-[15px] font-semibold text-body transition-[background-color,border-color,color] duration-300 ease-out hover:border-brand hover:bg-tint hover:text-brand peer-checked:border-brand peer-checked:bg-brand peer-checked:text-white peer-checked:hover:bg-brand-deep peer-checked:hover:text-white peer-focus-visible:outline-2 peer-focus-visible:outline-brand">{t.monthly}</span>
      </label>
      <label class="cursor-pointer">
        <input type="radio" name="billing" value="annual" class="peer sr-only" />
        <span class="inline-flex min-h-11 items-center rounded-full border border-line bg-white px-5 text-[15px] font-semibold text-body transition-[background-color,border-color,color] duration-300 ease-out hover:border-brand hover:bg-tint hover:text-brand peer-checked:border-brand peer-checked:bg-brand peer-checked:text-white peer-checked:hover:bg-brand-deep peer-checked:hover:text-white peer-focus-visible:outline-2 peer-focus-visible:outline-brand">{t.annual}</span>
      </label>
    </div>
  </fieldset>

  <div class="grid gap-5 sm:grid-cols-2">
    <div class="flex flex-col gap-2">
      <label for="f-name" class={labelCls}>{t.name}</label>
      <input id="f-name" name="name" type="text" autocomplete="name" required class={field} />
    </div>
    <div class="flex flex-col gap-2">
      <label for="f-email" class={labelCls}>{t.email}</label>
      <input id="f-email" name="email" type="email" autocomplete="email" required class={field} />
    </div>
    <div class="flex flex-col gap-2">
      <label for="f-company" class={labelCls}>{t.company}</label>
      <input id="f-company" name="company" type="text" autocomplete="organization" class={field} />
    </div>
    <div class="flex flex-col gap-2">
      <label for="f-website" class={labelCls}>{t.website}</label>
      <input id="f-website" name="website" type="text" inputmode="url" placeholder={t.websitePh} class={field} />
    </div>
  </div>

  <div class="flex flex-col gap-2">
    <label for="f-platform" class={labelCls}>{t.platform}</label>
    <select id="f-platform" name="platform" class={field}>
      <option value="" selected>{t.platformPh}</option>
      {platformOptions(lang).map((p) => <option value={p}>{p}</option>)}
    </select>
  </div>

  <div class="flex flex-col gap-2">
    <label for="f-message" class={labelCls}>{t.message}</label>
    <textarea id="f-message" name="message" rows="5" class={field} placeholder={t.messagePh}></textarea>
  </div>

  <!-- Honeypot: humans never see or fill this -->
  <div class="hidden" aria-hidden="true">
    <label for="f-company-url">{t.honeypot}</label>
    <input id="f-company-url" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <label class="flex items-start gap-3 text-[14px] leading-snug text-body">
    <input type="checkbox" name="consent" required class="mt-0.5 size-5 shrink-0 accent-[#2D327D]" />
    <span>{t.consent[0]}<a href={localize('/privacy/', lang)}>{t.consent[1]}</a>{t.consent[2]}</span>
  </label>

  <button type="submit" class="btn btn-primary w-full sm:w-fit">{submitLabel}</button>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('.inquiry-form').forEach((form) => {
    const select = form.querySelector<HTMLSelectElement>('select[name="interest"]');
    const billing = form.querySelector<HTMLFieldSetElement>('.billing-field');
    const billable = (form.dataset.billable ?? '').split(' ');
    const params = new URLSearchParams(location.search);

    const plan = params.get('plan');
    if (select && plan && [...select.options].some((o) => o.value === plan)) select.value = plan;
    if (params.get('billing') === 'annual') {
      const annual = form.querySelector<HTMLInputElement>('input[name="billing"][value="annual"]');
      if (annual) annual.checked = true;
    }

    const syncBilling = () => {
      if (billing && select) billing.hidden = !billable.includes(select.value);
    };
    select?.addEventListener('change', syncBilling);
    syncBilling();

    // No form endpoint yet: open the visitor's email app with the enquiry prefilled.
    if (!form.getAttribute('action')) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        if (!form.reportValidity()) return;
        const data = new FormData(form);
        if (data.get('_gotcha')) return;
        const interest = select?.selectedOptions[0]?.text ?? '';
        const m = JSON.parse(form.dataset.mail ?? '{}') as Record<string, string>;
        const lines = [
          `${m.interest}: ${interest}`,
          ...(billing && !billing.hidden ? [`${m.billing}: ${m[String(data.get('billing'))]}`] : []),
          `${m.name}: ${data.get('name')}`,
          `${m.email}: ${data.get('email')}`,
          `${m.company}: ${data.get('company') || '-'}`,
          `${m.website}: ${data.get('website') || '-'}`,
          `${m.platform}: ${data.get('platform') || '-'}`,
          '',
          String(data.get('message') || ''),
        ];
        location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(`Upnestly — ${interest}`)}&body=${encodeURIComponent(lines.join('\n'))}`;
      });
    }
  });
</script>
