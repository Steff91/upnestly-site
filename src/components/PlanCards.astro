---
// Three monthly plans + the Custom CTA. With `toggle`, shows a Monthly / Annual switch (annual = discounted monthly price, billed yearly).
import Icon from './Icon.astro';
import data from '../data/plans.json';
import pricing from '../data/pricing.json';
import { planHref } from '../data/inquiry';

interface Props {
  toggle?: boolean;
}
const { toggle = false } = Astro.props;


const discount = pricing.annualDiscount;
const toNumber = (price: string) => Number(price.replace(/[^\d]/g, ''));
const annualPrice = (price: string) => `€${Math.round(toNumber(price) * (1 - discount / 100)).toLocaleString('en-US')}`;

const plans = data.plans.filter((p) => p.name !== 'Custom');
const custom = data.plans.find((p) => p.name === 'Custom');
---

<div class="plan-cards flex flex-col gap-5" data-billing="monthly">
  {toggle && (
    <div class="flex flex-wrap items-center gap-4" data-reveal>
      <div class="inline-flex rounded-full border border-line bg-white p-1" role="group" aria-label="Billing period">
        <button type="button" class="billing-btn min-h-11 rounded-full px-5 text-[15px] font-semibold" data-set-billing="monthly" aria-pressed="true">Monthly</button>
        <button type="button" class="billing-btn min-h-11 rounded-full px-5 text-[15px] font-semibold" data-set-billing="annual" aria-pressed="false">Annual</button>
      </div>
      <span class="rounded-full bg-night-accent/40 px-3 py-1 text-[13px] font-semibold text-brand-deep">Save {discount}% with annual billing</span>
    </div>
  )}

  <p class="m-0 -mb-2 text-[13px] font-medium text-dim lg:hidden">Swipe to compare plans →</p>
  <div class="-mx-6 flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-px-6 px-6 pb-3 pt-4 lg:mx-0 lg:grid lg:grid-cols-3 lg:gap-5 lg:overflow-visible lg:p-0">
    {plans.map((plan, i) => (
      <article
        class:list={['relative flex w-[86%] shrink-0 snap-start flex-col gap-6 rounded-[20px] p-8 sm:w-[60%] md:w-[46%] lg:w-auto lg:p-9', plan.featured ? 'bg-ink text-white' : 'bg-white']}
        data-reveal
        style={`--i:${i}`}
      >
        {plan.featured && (
          <span class="absolute -top-3 left-8 rounded-full bg-night-accent px-3 py-1 text-[11.5px] font-bold uppercase tracking-[0.1em] text-ink lg:left-9">Most chosen</span>
        )}
        <div class="flex flex-col gap-2">
          <h3 class="m-0 text-[24px] font-extrabold">{plan.name}</h3>
          <p class:list={['m-0 text-[15px] leading-normal', plan.featured ? 'text-night-text' : 'text-body']}>{plan.blurb}</p>
        </div>
        <div class="flex flex-col gap-1">
          <p class="m-0 flex items-baseline gap-2">
            <span class="price-monthly text-[44px] font-extrabold leading-none tracking-[-0.02em]">{plan.price}</span>
            {toggle && <span class="price-annual text-[44px] font-extrabold leading-none tracking-[-0.02em]">{annualPrice(plan.price)}</span>}
            <span class:list={['text-[15px]', plan.featured ? 'text-night-text' : 'text-muted']}>{plan.period}</span>
          </p>
          {toggle && (
            <p class:list={['m-0 min-h-[1.5em] text-[13px]', plan.featured ? 'text-night-text' : 'text-muted']}>
              <span class="price-annual">Billed yearly · <s>{plan.price}</s></span>
              <span class="price-monthly">Billed monthly</span>
            </p>
          )}
        </div>

        <div class="flex flex-col gap-5">
          {plan.groups.map((g) => (
            <div class="flex flex-col gap-2">
              <p class:list={['m-0 label', plan.featured ? 'text-night-accent' : 'text-brand']}>{g.label}</p>
              <ul class="m-0 flex list-none flex-col gap-1.5 p-0 text-[15px] leading-snug">
                {g.items.map((item) => (
                  <li class="flex gap-2.5">
                    <Icon name="check" size={16} class:list={['mt-0.5 shrink-0', plan.featured ? 'text-night-accent' : 'text-brand']} />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        <a href={planHref(plan.name)} data-plan-link class:list={['btn mt-auto w-full', plan.featured ? 'btn-light' : 'btn-primary']}>{plan.cta}</a>
      </article>
    ))}
  </div>

  {custom && (
    <aside class="flex flex-wrap items-center gap-x-12 gap-y-6 rounded-[20px] border-2 border-dashed border-[#B9BEDF] bg-white/60 p-9" aria-labelledby="custom-plan" data-reveal>
      <div class="flex min-w-0 flex-[1_1_320px] flex-col gap-2">
        <h3 id="custom-plan" class="m-0 text-[24px] font-extrabold">Need something else? <span class="text-brand">Custom.</span></h3>
        <p class="m-0 text-[15px] leading-normal text-body">{custom.blurb}</p>
      </div>
      <ul class="m-0 grid min-w-0 flex-[1_1_380px] list-none grid-cols-[repeat(auto-fit,minmax(180px,1fr))] gap-x-6 gap-y-2 p-0 text-[15px] leading-snug">
        {custom.groups.flatMap((g) => g.items).map((item) => (
          <li class="flex gap-2.5">
            <Icon name="check" size={16} class="mt-0.5 shrink-0 text-brand" />
            <span>{item}</span>
          </li>
        ))}
      </ul>
      <a href={planHref(custom.name)} class="btn btn-outline shrink-0">{custom.cta}</a>
    </aside>
  )}
</div>

<style>
  .plan-cards[data-billing='monthly'] .price-annual,
  .plan-cards[data-billing='annual'] .price-monthly { display: none; }
  .billing-btn { color: var(--color-body); cursor: pointer; transition: background-color .3s ease-out, color .3s ease-out; }
  .billing-btn:hover { background: var(--color-tint); color: var(--color-brand); }
  .billing-btn[aria-pressed='true'] { background: var(--color-brand); color: #fff; }
  .billing-btn[aria-pressed='true']:hover { background: var(--color-brand-deep); color: #fff; }
  @media (prefers-reduced-motion: reduce) { .billing-btn { transition: none; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.plan-cards').forEach((root) => {
    const buttons = root.querySelectorAll<HTMLButtonElement>('[data-set-billing]');
    buttons.forEach((btn) =>
      btn.addEventListener('click', () => {
        root.dataset.billing = btn.dataset.setBilling;
        // Carry the billing choice into the contact form
        root.querySelectorAll<HTMLAnchorElement>('[data-plan-link]').forEach((a) => {
          const url = new URL(a.href);
          if (btn.dataset.setBilling === 'annual') url.searchParams.set('billing', 'annual');
          else url.searchParams.delete('billing');
          a.href = url.pathname + url.search;
        });
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      }),
    );
  });
</script>
