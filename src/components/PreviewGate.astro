---
// "Coming soon" screen with a password, shown until launch (PUBLIC_SITE_LIVE=true).
// Meant for sharing previews, not for real security: the page is still in the HTML.
// Only a SHA-256 hash of the password is shipped. Change it with the PREVIEW_PASSWORD env variable.
import Logo from './Logo.astro';
import { previewHash } from '../lib/preview';
import { getLang } from '../i18n';
const lang = getLang(Astro.url);
const t = {
  en: { soon: 'Coming soon', title: 'Your digital team on one monthly plan.', text: 'We’re putting the finishing touches on our new site. Have a preview password? Enter it below.', password: 'Password', enter: 'Enter', wrong: 'Wrong password — please try again.', questions: 'Questions?' },
  de: { soon: 'Bald verfügbar', title: 'Ihr Digital-Team in einem Monatsplan.', text: 'Wir legen gerade letzte Hand an unsere neue Website. Sie haben ein Vorschau-Passwort? Geben Sie es hier ein.', password: 'Passwort', enter: 'Weiter', wrong: 'Falsches Passwort – bitte erneut versuchen.', questions: 'Fragen?' },
}[lang];
---

<div id="preview-gate" role="dialog" aria-modal="true" aria-labelledby="gate-title" data-hash={previewHash} data-wrong={t.wrong}>
  <div class="gate-inner">
    <Logo class="h-10 w-auto" />
    <p class="label m-0 text-brand">{t.soon}</p>
    <h1 id="gate-title" class="m-0 text-[clamp(32px,5vw,52px)] font-extrabold leading-[1.05] tracking-[-0.03em] text-ink">
      {t.title}
    </h1>
    <p class="m-0 max-w-[460px] text-[17px] leading-[1.6] text-body">
      {t.text}
    </p>
    <form class="gate-form flex w-full max-w-[420px] flex-col gap-3 sm:flex-row" novalidate>
      <label for="gate-password" class="sr-only">{t.password}</label>
      <input
        id="gate-password"
        type="password"
        autocomplete="current-password"
        placeholder={t.password}
        required
        class="min-h-12 w-full flex-1 rounded-full border border-line bg-white px-5 text-[16px] text-ink outline-none transition-colors duration-300 focus:border-brand"
      />
      <button type="submit" class="btn btn-primary cursor-pointer border-0">{t.enter}</button>
    </form>
    <p class="gate-error m-0 min-h-[1.4em] text-[14px] font-semibold text-[#B42318]" role="alert" aria-live="assertive"></p>
    <p class="m-0 text-[14px] text-muted">{t.questions} <a href="mailto:info@upnestly.net">info@upnestly.net</a></p>
  </div>
</div>

<style is:global>
  #preview-gate { display: none; }
  html.gated { overflow: hidden; }
  html.gated #preview-gate {
    display: flex;
    position: fixed;
    inset: 0;
    z-index: 100;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background: var(--color-tint);
    overflow-y: auto;
  }
  html.gated body > :not(#preview-gate) { display: none !important; }
  #preview-gate .gate-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
    width: 100%;
    max-width: 640px;
  }
</style>

<script>
  const gate = document.getElementById('preview-gate');
  const form = gate?.querySelector<HTMLFormElement>('.gate-form');
  const input = gate?.querySelector<HTMLInputElement>('#gate-password');
  const error = gate?.querySelector<HTMLElement>('.gate-error');
  const expected = gate?.dataset.hash ?? '';

  const sha256 = async (text: string) => {
    const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(text));
    return [...new Uint8Array(buf)].map((b) => b.toString(16).padStart(2, '0')).join('');
  };

  if (document.documentElement.classList.contains('gated')) input?.focus();

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!input || !error) return;
    let ok = false;
    try { ok = (await sha256(input.value.trim())) === expected; } catch { ok = false; }
    if (!ok) {
      error.textContent = gate?.dataset.wrong ?? 'Wrong password';
      input.select();
      return;
    }
    try { localStorage.setItem('upn-preview', expected); } catch { /* private mode: unlocked for this page view only */ }
    document.documentElement.classList.remove('gated');
    error.textContent = '';
  });
</script>
