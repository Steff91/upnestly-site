---
import Icon from '../Icon.astro';
import data from '../../data/plans.json';
import site from '../../data/site.json';

const quoteHref = (plan: string) =>
  site.auditUrl.startsWith('mailto:')
    ? `mailto:${site.email}?subject=${encodeURIComponent(`Upnestly — ${plan} plan`)}`
    : site.auditUrl;
---

<section id="pricing" class="bg-tint">
  <div class="container-site flex flex-col gap-12 py-24 lg:py-26">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="flex max-w-[680px] flex-col gap-4" data-reveal>
        <p class="eyebrow m-0">Plans & pricing</p>
        <h2 class="h-section">{data.title}</h2>
      </div>
      <p class="lead max-w-[440px]" data-reveal style="--i:1">{data.intro}</p>
    </div>

    <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,260px),1fr))] gap-5">
      {data.plans.map((plan, i) => {
        const custom = plan.name === 'Custom';
        return (
          <article
            class:list={[
              'relative flex flex-col gap-6 rounded-[20px] p-8',
              plan.featured ? 'bg-ink text-white' : custom ? 'border-2 border-dashed border-[#B9BEDF] bg-transparent' : 'bg-white',
            ]}
            data-reveal
            style={`--i:${i}`}
          >
            {plan.featured && (
              <span class="absolute -top-3 left-8 rounded-full bg-night-accent px-3 py-1 font-mono text-[12px] font-medium text-ink">Most chosen</span>
            )}
            <div class="flex flex-col gap-2">
              <h3 class="m-0 text-[22px] font-extrabold">{plan.name}</h3>
              <p class:list={['m-0 min-h-[3.2em] text-[15px] leading-normal', plan.featured ? 'text-night-text' : 'text-body']}>{plan.blurb}</p>
            </div>
            <p class="m-0 flex items-baseline gap-2">
              <span class="text-[38px] font-extrabold leading-none tracking-[-0.02em]">{plan.price}</span>
              {plan.period && <span class:list={['text-[15px]', plan.featured ? 'text-night-text' : 'text-muted']}>{plan.period}</span>}
            </p>

            <div class="flex flex-col gap-5">
              {plan.groups.map((g) => (
                <div class="flex flex-col gap-2">
                  <p class:list={['m-0 font-mono text-[12px] uppercase tracking-[0.08em]', plan.featured ? 'text-night-accent' : 'text-brand']}>{g.label}</p>
                  <ul class="m-0 flex list-none flex-col gap-1.5 p-0 text-[14.5px] leading-snug">
                    {g.items.map((item) => (
                      <li class="flex gap-2">
                        <Icon name="check" size={16} class:list={['mt-0.5 shrink-0', plan.featured ? 'text-night-accent' : 'text-brand']} />
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>

            <a
              href={quoteHref(plan.name)}
              class:list={['btn mt-auto w-full', plan.featured ? 'btn-light' : custom ? 'btn-outline' : 'btn-primary']}
            >
              {plan.cta}
            </a>
          </article>
        );
      })}
    </div>

    <p class="m-0 max-w-[820px] text-[14px] leading-relaxed text-muted" data-reveal>{data.footnote}</p>
  </div>
</section>
