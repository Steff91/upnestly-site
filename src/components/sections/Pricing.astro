---
import Icon from '../Icon.astro';
import data from '../../data/plans.json';
import site from '../../data/site.json';

const quoteHref = (plan: string) =>
  site.auditUrl.startsWith('mailto:')
    ? `mailto:${site.email}?subject=${encodeURIComponent(`Upnestly — ${plan} plan`)}`
    : site.auditUrl;

// The Custom plan renders as a wide CTA below the three monthly plans.
const plans = data.plans.filter((p) => p.name !== 'Custom');
const custom = data.plans.find((p) => p.name === 'Custom');
---

<section id="pricing" class="bg-tint">
  <div class="container-site flex flex-col gap-12 py-24 lg:py-26">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="flex max-w-[680px] flex-col gap-4" data-reveal>
        <p class="eyebrow m-0">Plans & pricing</p>
        <h2 class="h-section">{data.title}</h2>
      </div>
      <p class="lead max-w-[440px]" data-reveal style="--i:1">{data.intro}</p>
    </div>

    <div class="flex flex-col gap-5">
      <p class="m-0 -mb-2 text-[13px] font-medium text-dim lg:hidden">Swipe to compare plans →</p>
      <div class="-mx-6 flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-px-6 px-6 pb-3 pt-4 lg:mx-0 lg:grid lg:grid-cols-3 lg:gap-5 lg:overflow-visible lg:p-0">
        {plans.map((plan, i) => (
          <article
            class:list={['relative flex w-[86%] shrink-0 snap-start flex-col gap-6 rounded-[20px] p-8 sm:w-[60%] md:w-[46%] lg:w-auto lg:p-9', plan.featured ? 'bg-ink text-white' : 'bg-white']}
            data-reveal
            style={`--i:${i}`}
          >
            {plan.featured && (
              <span class="absolute -top-3 left-8 rounded-full lg:left-9 bg-night-accent px-3 py-1 text-[11.5px] font-bold uppercase tracking-[0.1em] text-ink">Most chosen</span>
            )}
            <div class="flex flex-col gap-2">
              <h3 class="m-0 text-[24px] font-extrabold">{plan.name}</h3>
              <p class:list={['m-0 text-[15px] leading-normal', plan.featured ? 'text-night-text' : 'text-body']}>{plan.blurb}</p>
            </div>
            <p class="m-0 flex items-baseline gap-2">
              <span class="text-[44px] font-extrabold leading-none tracking-[-0.02em]">{plan.price}</span>
              <span class:list={['text-[15px]', plan.featured ? 'text-night-text' : 'text-muted']}>{plan.period}</span>
            </p>

            <div class="flex flex-col gap-5">
              {plan.groups.map((g) => (
                <div class="flex flex-col gap-2">
                  <p class:list={['m-0 label', plan.featured ? 'text-night-accent' : 'text-brand']}>{g.label}</p>
                  <ul class="m-0 flex list-none flex-col gap-1.5 p-0 text-[15px] leading-snug">
                    {g.items.map((item) => (
                      <li class="flex gap-2.5">
                        <Icon name="check" size={16} class:list={['mt-0.5 shrink-0', plan.featured ? 'text-night-accent' : 'text-brand']} />
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>

            <a href={quoteHref(plan.name)} class:list={['btn mt-auto w-full', plan.featured ? 'btn-light' : 'btn-primary']}>{plan.cta}</a>
          </article>
        ))}
      </div>

      {custom && (
        <aside class="flex flex-wrap items-center gap-x-12 gap-y-6 rounded-[20px] border-2 border-dashed border-[#B9BEDF] bg-white/60 p-9" aria-labelledby="custom-plan" data-reveal>
          <div class="flex min-w-0 flex-[1_1_320px] flex-col gap-2">
            <h3 id="custom-plan" class="m-0 text-[24px] font-extrabold">Need something else? <span class="text-brand">Custom.</span></h3>
            <p class="m-0 text-[15px] leading-normal text-body">{custom.blurb}</p>
          </div>
          <ul class="m-0 grid min-w-0 flex-[1_1_380px] list-none grid-cols-[repeat(auto-fit,minmax(180px,1fr))] gap-x-6 gap-y-2 p-0 text-[15px] leading-snug">
            {custom.groups.flatMap((g) => g.items).map((item) => (
              <li class="flex gap-2.5">
                <Icon name="check" size={16} class="mt-0.5 shrink-0 text-brand" />
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <a href={quoteHref(custom.name)} class="btn btn-outline shrink-0">{custom.cta}</a>
        </aside>
      )}
    </div>

    <p class="m-0 max-w-[820px] text-[14px] leading-relaxed text-muted" data-reveal>{data.footnote}</p>
  </div>
</section>
