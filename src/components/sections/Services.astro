---
import Icon from '../Icon.astro';
import { getLang, localize } from '../../i18n';

const lang = getLang(Astro.url);

// The four disciplines. All of them are ongoing monthly work — none is a one-off.
const t = {
  en: {
    title: 'Build. Grow. Automate. Run. Every month, from one team.',
    lead: 'Most businesses juggle a developer, a marketing agency, an IT freelancer and a hosting company. We are all four — and we keep working on your site and your processes, month after month.',
    included: 'Included in every plan', includedText: 'All four disciplines, every month.', seePlans: 'See plans', all: 'All services',
    services: [
      {
        n: '01 — Build',
        title: 'Website & shop development',
        text: 'Your site is never “done”. We keep shipping new pages and features, fix what breaks and maintain the platform — WordPress, Shopify, Webflow, Magento or custom code.',
        items: ['New pages, features & UX improvements', 'Platform maintenance & bug fixes', 'Landing pages for campaigns'],
        links: [{ href: '/services/development/', label: 'Development & design' }],
      },
      {
        n: '02 — Grow',
        title: 'Content, search, ads & CRO',
        text: 'Multilingual content, SEO that ranks in Google and gets cited by AI search, campaigns tied to revenue — and a site that turns that traffic into leads and sales.',
        items: ['Content in English & German', 'SEO & AI search (GEO)', 'Google & Meta ads, reporting', 'Conversion optimization (CRO) & A/B testing'],
        links: [{ href: '/services/seo-content/', label: 'SEO & content' }, { href: '/services/cro-ads/', label: 'CRO & paid ads' }],
      },
      {
        n: '03 — Automate',
        title: 'Processes, CRM & AI',
        text: 'The work behind the website: we map how your team works, set up or build the CRM and internal tools behind it, and automate the busywork with AI.',
        items: ['CRM setup & integrations', 'Custom internal tools & dashboards', 'AI automation with a human checkpoint'],
        links: [{ href: '/services/crm-internal-tools/', label: 'CRM & internal tools' }, { href: '/services/ai-automation/', label: 'AI automation' }],
      },
      {
        n: '04 — Run',
        title: 'Hosting, security & care',
        text: 'Managed EU hosting for websites and internal tools; on Shopify and Webflow we look after apps, themes and backups. Handled by a senior systems engineer, not a ticket queue.',
        items: ['Managed EU hosting or platform care', 'Updates, backups, uptime monitoring', 'Security & GDPR documentation'],
        links: [{ href: '/services/hosting-care/', label: 'Hosting & care' }],
      },
    ],
  },
  de: {
    title: 'Build. Grow. Automate. Run. Jeden Monat, aus einem Team.',
    lead: 'Die meisten Unternehmen jonglieren mit einem Entwickler, einer Marketingagentur, einem IT-Freelancer und einem Hoster. Wir sind alle vier – und arbeiten Monat für Monat an Ihrer Website und Ihren Prozessen weiter.',
    included: 'In jedem Plan enthalten', includedText: 'Alle vier Disziplinen, jeden Monat.', seePlans: 'Pläne ansehen', all: 'Alle Leistungen',
    services: [
      {
        n: '01 — Build',
        title: 'Website- & Shop-Entwicklung',
        text: 'Eine Website ist nie „fertig“. Wir liefern laufend neue Seiten und Features, beheben, was kaputtgeht, und pflegen die Plattform – WordPress, Shopify, Webflow, Magento oder Custom Code.',
        items: ['Neue Seiten, Features & UX-Verbesserungen', 'Plattform-Wartung & Fehlerbehebung', 'Landingpages für Kampagnen'],
        links: [{ href: '/services/development/', label: 'Entwicklung & Design' }],
      },
      {
        n: '02 — Grow',
        title: 'Content, Suche, Ads & CRO',
        text: 'Mehrsprachiger Content, SEO, das in Google rankt und von KI-Suchen zitiert wird, Kampagnen mit Bezug zum Umsatz – und eine Website, die aus diesem Traffic Leads und Verkäufe macht.',
        items: ['Content auf Deutsch & Englisch', 'SEO & KI-Suche (GEO)', 'Google Ads & Meta Ads, Reporting', 'Conversion-Optimierung (CRO) & A/B-Tests'],
        links: [{ href: '/services/seo-content/', label: 'SEO & Content' }, { href: '/services/cro-ads/', label: 'CRO & Werbeanzeigen' }],
      },
      {
        n: '03 — Automate',
        title: 'Prozesse, CRM & KI',
        text: 'Die Arbeit hinter der Website: Wir bilden ab, wie Ihr Team arbeitet, richten das passende CRM und interne Tools ein oder entwickeln sie und automatisieren Routinearbeit mit KI.',
        items: ['CRM-Einführung & Integrationen', 'Individuelle interne Tools & Dashboards', 'KI-Automatisierung mit menschlichem Prüfschritt'],
        links: [{ href: '/services/crm-internal-tools/', label: 'CRM & interne Tools' }, { href: '/services/ai-automation/', label: 'KI-Automatisierung' }],
      },
      {
        n: '04 — Run',
        title: 'Hosting, Sicherheit & Betreuung',
        text: 'Managed Hosting in der EU für Websites und interne Tools; bei Shopify und Webflow kümmern wir uns um Apps, Themes und Backups. Betreut von einem Senior Systems Engineer, nicht von einer Ticket-Warteschlange.',
        items: ['Managed Hosting in der EU oder Plattform-Betreuung', 'Updates, Backups, Uptime-Monitoring', 'Sicherheit & DSGVO-Dokumentation'],
        links: [{ href: '/services/hosting-care/', label: 'Hosting & Betreuung' }],
      },
    ],
  },
}[lang];
---

<section id="services">
  <div class="container-site flex flex-col gap-12 py-24 lg:py-26">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <h2 class="h-section max-w-[640px]" data-reveal>{t.title}</h2>
      <p class="lead max-w-[440px]" data-reveal style="--i:1">{t.lead}</p>
    </div>

    <div class="grid gap-5 md:grid-cols-2">
      {t.services.map((s, i) => (
        <article class="flex flex-col gap-4.5 rounded-[20px] border border-line p-9" data-reveal style={`--i:${i}`}>
          <p class="m-0 label text-brand">{s.n}</p>
          <h3 class="m-0 text-[26px] font-extrabold leading-tight tracking-[-0.01em]">{s.title}</h3>
          <p class="m-0 text-[15px] leading-[1.6] text-body">{s.text}</p>
          <ul class="m-0 flex list-none flex-col gap-2 p-0 text-[15px] leading-snug">
            {s.items.map((item) => (
              <li class="flex gap-2.5">
                <Icon name="check" size={16} class="mt-0.5 shrink-0 text-brand" />
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <p class="m-0 mt-auto flex flex-wrap gap-x-5 gap-y-1 border-t border-line-soft pt-4 text-[15px] font-semibold">
            {s.links.map((l) => <a href={localize(l.href, lang)} class="inline-flex items-center gap-1.5">{l.label} <span aria-hidden="true">→</span></a>)}
          </p>
        </article>
      ))}
    </div>

    <p class="m-0 flex flex-wrap items-center gap-x-3 gap-y-2 text-[15px] text-body" data-reveal>
      <span class="rounded-full bg-tint px-3 py-1 label text-brand">{t.included}</span>
      {t.includedText} <a href="#pricing" class="font-semibold">{t.seePlans}</a> · <a href={localize('/services/', lang)} class="font-semibold">{t.all}</a>
    </p>
  </div>
</section>
