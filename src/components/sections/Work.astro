---
import { getCollection } from 'astro:content';
import WorkCard from '../WorkCard.astro';

const work = (await getCollection('work', (e) => e.data.featured)).sort((a, b) => a.data.order - b.data.order).slice(0, 3);
---

<section id="work">
  <div class="container-site flex flex-col gap-10 py-24 lg:py-26">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 class="h-section" data-reveal>Selected work</h2>
      <a href="/work/" class="font-semibold" data-reveal>All work →</a>
    </div>
    <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,320px),1fr))] gap-6">
      {work.map((entry, i) => <WorkCard entry={entry} index={i} />)}
    </div>
  </div>
</section>
