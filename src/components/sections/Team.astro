---
import Icon from '../Icon.astro';
import { getLang, localize } from '../../i18n';

const lang = getLang(Astro.url);
const t = {
  en: {
    title: 'Five senior specialists. No juniors, no handoffs.',
    lead: 'Each discipline is led by someone with years of hands-on experience. You talk directly to the people doing the work.',
    team: [
      { stat: '8+ yrs', title: 'Development, AI & automation', text: 'Builds websites, shops and SaaS platforms, plus the AI automations behind them (Claude API, n8n), for clients across Europe.' },
      { stat: '8+ yrs', title: 'Content & marketing', text: 'Large-scale retail campaigns and international marketing projects; eCommerce, content strategy and SEO, with deep knowledge of the DACH market.' },
      { stat: '6+ yrs', title: 'Shopify & front-end', text: 'Shopify stores for US and EU e-commerce brands: Liquid sections, product and landing pages, campaigns and fast, editable templates.' },
      { stat: '15+ yrs', title: 'Product & project management', text: 'Scrum Master by training with 15+ years in IT, from eCommerce to enterprise systems. Knows what companies need from their apps — and keeps every project on track.' },
      { stat: '30 yrs', title: 'Infrastructure & DevOps', text: 'Senior IT administrator who builds, runs and secures Linux servers and hosting for government, e-commerce and media clients.' },
    ],
    contactStrong: 'One point of contact for everything.',
    contactText: 'One project manager, one invoice, one contract — in English or German, in your time zone.',
    meet: 'Meet the team',
  },
  de: {
    title: 'Fünf Senior-Spezialisten. Keine Juniors, keine Übergaben.',
    lead: 'Jede Disziplin wird von jemandem mit langjähriger Praxiserfahrung geleitet. Sie sprechen direkt mit den Menschen, die die Arbeit machen.',
    team: [
      { stat: '8+ Jahre', title: 'Entwicklung, KI & Automatisierung', text: 'Baut Websites, Shops und SaaS-Plattformen – und die KI-Automatisierungen dahinter (Claude API, n8n) – für Kunden in ganz Europa.' },
      { stat: '8+ Jahre', title: 'Content & Marketing', text: 'Große Retail-Kampagnen und internationale Marketingprojekte; E-Commerce, Content-Strategie und SEO, mit fundierter Kenntnis des DACH-Markts.' },
      { stat: '6+ Jahre', title: 'Shopify & Frontend', text: 'Shopify-Shops für E-Commerce-Marken aus den USA und der EU: Liquid-Sections, Produkt- und Landingpages, Kampagnen und schnelle, editierbare Templates.' },
      { stat: '15+ Jahre', title: 'Produkt- & Projektmanagement', text: 'Ausgebildeter Scrum Master mit über 15 Jahren in der IT, von E-Commerce bis zu Unternehmenssystemen. Weiß, was Unternehmen von ihren Apps brauchen – und hält jedes Projekt auf Kurs.' },
      { stat: '30 Jahre', title: 'Infrastruktur & DevOps', text: 'Senior-IT-Administrator, der Linux-Server und Hosting für Kunden aus Verwaltung, E-Commerce und Medien aufbaut, betreibt und absichert.' },
    ],
    contactStrong: 'Ein Ansprechpartner für alles.',
    contactText: 'Ein Projektmanager, eine Rechnung, ein Vertrag – auf Deutsch oder Englisch, in Ihrer Zeitzone.',
    meet: 'Das Team kennenlernen',
  },
}[lang];
---

<section id="team">
  <div class="container-site flex flex-col gap-10 py-24 lg:py-26">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <h2 class="h-section max-w-[680px]" data-reveal>{t.title}</h2>
      <p class="lead max-w-[440px]" data-reveal style="--i:1">{t.lead}</p>
    </div>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
      {t.team.map((m, i) => (
        <div class="flex flex-col gap-3 rounded-[20px] bg-tint-soft p-8" data-reveal style={`--i:${i}`}>
          <p class="m-0 text-[44px] font-extrabold tracking-[-0.02em] text-brand xl:text-[38px]">{m.stat}</p>
          <h3 class="m-0 text-[19px] font-bold">{m.title}</h3>
          <p class="m-0 text-[15px] leading-[1.6] text-body">{m.text}</p>
        </div>
      ))}
    </div>
    <div class="flex flex-wrap items-center gap-4 rounded-2xl border border-line px-7 py-6" data-reveal>
      <span class="flex size-11 shrink-0 items-center justify-center rounded-full bg-brand text-white"><Icon name="chat" /></span>
      <p class="m-0 min-w-0 flex-[1_1_320px] text-[16px] leading-normal"><strong>{t.contactStrong}</strong> {t.contactText}</p>
      <a href={localize('/team/', lang)} class="group inline-flex shrink-0 items-center gap-1.5 font-semibold">{t.meet} <Icon name="arrow" size={13} class="shrink-0 transition-transform duration-300 ease-out group-hover:translate-x-0.5" /></a>
    </div>
  </div>
</section>
