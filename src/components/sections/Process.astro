---
const steps = [
  { when: 'Week 1', title: 'Free audit', text: 'We review your site and recommend the plan that fits.' },
  { when: 'Week 2', title: 'Onboarding', text: 'Access, tracking, hosting setup where needed and a baseline report.' },
  { when: 'Month 1', title: 'First sprint', text: 'Quick wins across development, SEO and conversion.' },
  { when: 'Every month', title: 'Report & plan', text: 'Results, next priorities and one call with the whole team.' },
];
---

<section class="bg-tint">
  <div class="container-site flex flex-col gap-10 py-24 lg:py-26">
    <h2 class="h-section" data-reveal>How working with us starts</h2>
    <ol class="m-0 grid list-none grid-cols-[repeat(auto-fit,minmax(220px,1fr))] gap-5 p-0">
      {steps.map((s, i) => (
        <li class="flex flex-col gap-2.5 rounded-2xl bg-white p-7" data-reveal style={`--i:${i}`}>
          <span class="font-mono text-[13px] text-brand">{s.when}</span>
          <h3 class="m-0 text-[19px] font-bold">{s.title}</h3>
          <p class="m-0 text-[15px] leading-[1.55] text-body">{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
