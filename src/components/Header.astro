---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { getNav, getSite } from '../i18n/data';
import { getLang, langs, langMeta, localize, stripLang, switchLang } from '../i18n';

const lang = getLang(Astro.url);
const site = getSite(lang);
const nav = getNav(lang);
const t = { en: { home: 'Upnestly — home', open: 'Open menu', audit: 'Book a free audit', auditShort: 'Book a free audit', language: 'Language', mobile: 'Mobile', main: 'Main' }, de: { home: 'Upnestly — Startseite', open: 'Menü öffnen', audit: 'Kostenlosen Audit buchen', auditShort: 'Kostenloser Audit', language: 'Sprache', mobile: 'Mobil', main: 'Hauptnavigation' } }[lang];

// Highlight the current section. "Services" is not active on the AI page, which has its own nav item.
const path = stripLang(Astro.url.pathname);
const isActive = (href: string) => {
  const h = stripLang(href);
  return h === '/services/' ? path.startsWith('/services/') && !path.startsWith('/services/ai-automation/') : path.startsWith(h);
};
const switcher = langs.map((l) => ({ lang: l, href: switchLang(Astro.url.pathname, l), short: langMeta[l].short, label: langMeta[l].label, current: l === lang }));
---

<header class="sticky top-0 z-40 border-b border-line-soft bg-white/95 backdrop-blur">
  <div class="container-site flex items-center justify-between gap-6 py-4">
    <a href={localize('/', lang)} class="flex shrink-0 items-center" aria-label={t.home}>
      <Logo class="h-8 w-auto sm:h-9" />
    </a>

    <nav aria-label={t.main} class="hidden items-center gap-5 whitespace-nowrap text-[15px] font-medium lg:flex xl:gap-7">
      {nav.map((item) => (
        <a href={item.href} class="nav-link text-ink no-underline hover:text-brand" aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <nav aria-label={t.language} class="hidden items-center rounded-full border border-line p-0.5 text-[13px] font-bold lg:flex">
        {switcher.map((l) => (
          <a href={l.href} hreflang={l.lang} lang={l.lang} aria-label={l.label} aria-current={l.current ? 'true' : undefined} class="lang-link rounded-full px-2.5 py-1.5 no-underline">{l.short}</a>
        ))}
      </nav>
      <a href={site.auditUrl} class="btn btn-primary hidden whitespace-nowrap !px-5 !py-3 !text-[15px] sm:inline-flex">{t.auditShort}</a>

      <details class="relative lg:hidden" data-mobile-menu>
        <summary class="flex size-11 cursor-pointer list-none items-center justify-center rounded-full border border-line text-ink [&::-webkit-details-marker]:hidden" aria-label={t.open}>
          <Icon name="menu" />
        </summary>
        <nav aria-label={t.mobile} class="absolute right-0 top-14 flex w-64 flex-col gap-1 rounded-2xl border border-line bg-white p-3 shadow-lg">
          {nav.map((item) => (
            <a href={item.href} class="rounded-xl px-4 py-3 font-medium text-ink no-underline hover:bg-tint-soft">{item.label}</a>
          ))}
          <a href={site.auditUrl} class="btn btn-primary mt-2">{t.audit}</a>
          <div class="mt-2 flex items-center justify-between gap-3 border-t border-line-soft px-1 pt-3" role="group" aria-label={t.language}>
            <span class="text-[13px] font-semibold text-muted">{t.language}</span>
            <span class="flex rounded-full border border-line p-0.5 text-[13px] font-bold">
              {switcher.map((l) => (
                <a href={l.href} hreflang={l.lang} lang={l.lang} aria-label={l.label} aria-current={l.current ? 'true' : undefined} class="lang-link rounded-full px-3 py-1.5 no-underline">{l.short}</a>
              ))}
            </span>
          </div>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .lang-link { color: var(--color-body); transition: background-color .3s ease-out, color .3s ease-out; }
  .lang-link:hover { color: var(--color-brand); background: var(--color-tint); }
  .lang-link[aria-current='true'] { color: #fff; background: var(--color-brand); }
  /* Underline: fills from left to right on hover, stays full on the current page. */
  .nav-link { position: relative; transition: color .3s ease-out; }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -6px;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform .35s cubic-bezier(.2,.7,.2,1);
  }
  .nav-link:hover::after,
  .nav-link:focus-visible::after,
  .nav-link[aria-current='page']::after { transform: scaleX(1); }
  .nav-link[aria-current='page'] { color: var(--color-brand); }
  @media (prefers-reduced-motion: reduce) { .nav-link::after { transition: none; } }
</style>
