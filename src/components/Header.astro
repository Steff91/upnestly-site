---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { nav } from '../data/nav';
import site from '../data/site.json';

// Highlight the current section. "Services" is not active on the AI page, which has its own nav item.
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/services/'
    ? path.startsWith('/services/') && !path.startsWith('/services/ai-automation/')
    : path.startsWith(href);
const linkedin = site.linkedin.startsWith('http') ? site.linkedin : '#';
---

<header class="sticky top-0 z-40 border-b border-line-soft bg-white/95 backdrop-blur">
  <div class="container-site flex items-center justify-between gap-6 py-4">
    <a href="/" class="flex shrink-0 items-center" aria-label="Upnestly — home">
      <Logo class="h-8 w-auto sm:h-9" />
    </a>

    <nav aria-label="Main" class="hidden items-center gap-7 text-[15px] font-medium lg:flex">
      {nav.map((item) => (
        <a href={item.href} class="nav-link text-ink no-underline hover:text-brand" aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a href={site.auditUrl} class="btn btn-primary hidden !px-5 !py-3 !text-[15px] sm:inline-flex">Book a free audit</a>
      <button
        type="button"
        class="flex size-11 cursor-pointer items-center justify-center rounded-full border border-line bg-white text-ink transition-colors duration-300 hover:border-brand hover:text-brand lg:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-open
      >
        <Icon name="menu" />
      </button>
    </div>
  </div>
</header>

<!-- Full-screen mobile menu. Lives outside <header>: its backdrop-filter would trap a fixed child. -->
<div id="mobile-menu" class="mobile-menu fixed inset-0 z-50 flex flex-col overflow-y-auto bg-white lg:hidden" role="dialog" aria-modal="true" aria-label="Menu" data-open="false" inert>
  <div class="container-site flex items-center justify-between gap-6 py-4">
    <a href="/" class="flex shrink-0 items-center" aria-label="Upnestly — home">
      <Logo class="h-8 w-auto sm:h-9" />
    </a>
    <button type="button" class="flex size-11 cursor-pointer items-center justify-center rounded-full border border-line bg-white text-ink transition-colors duration-300 hover:border-brand hover:text-brand" aria-label="Close menu" data-menu-close>
      <Icon name="close" />
    </button>
  </div>

  <div class="container-site flex flex-1 flex-col gap-10 pb-10 pt-8">
    <nav aria-label="Mobile" class="flex flex-col">
      {nav.map((item, i) => (
        <a
          href={item.href}
          class="menu-item flex items-center justify-between border-b border-line-soft py-4 text-[28px] font-extrabold tracking-[-0.02em] text-ink no-underline hover:text-brand"
          style={`--d:${80 + i * 45}ms`}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
          <Icon name="arrow" size={20} class="text-brand" />
        </a>
      ))}
    </nav>

    <div class="menu-item mt-auto flex flex-col gap-6" style="--d:340ms">
      <a href={site.auditUrl} class="btn btn-primary w-full !py-4">Book a free audit</a>
      <div class="flex items-center justify-between gap-4 text-[15px]">
        <a href={`mailto:${site.email}`} class="inline-flex items-center gap-2 text-body no-underline hover:text-brand">
          <Icon name="mail" size={16} class="text-brand" />{site.email}
        </a>
        <a href={linkedin} aria-label="Upnestly on LinkedIn" class="flex size-11 items-center justify-center rounded-full border border-line text-ink transition-colors duration-300 hover:border-brand hover:text-brand">
          <Icon name="linkedin" size={17} />
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  .nav-link { position: relative; transition: color .3s ease-out; }
  .nav-link[aria-current='page'] { color: var(--color-brand); }
  .nav-link[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -6px;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
  }

  .mobile-menu {
    opacity: 0;
    visibility: hidden;
    transition: opacity .3s ease-out, visibility 0s linear .3s;
  }
  .mobile-menu[data-open='true'] {
    opacity: 1;
    visibility: visible;
    transition: opacity .3s ease-out, visibility 0s;
  }
  .menu-item[aria-current='page'] { color: var(--color-brand); }
  .menu-item {
    opacity: 0;
    translate: 0 10px;
    transition: opacity .35s ease-out, translate .35s ease-out, color .3s ease-out;
  }
  .mobile-menu[data-open='true'] .menu-item {
    opacity: 1;
    translate: 0 0;
    transition-delay: var(--d), var(--d), 0s;
  }
  @media (prefers-reduced-motion: reduce) {
    .mobile-menu, .mobile-menu[data-open='true'], .menu-item, .mobile-menu[data-open='true'] .menu-item { transition: none; translate: none; }
  }
</style>

<script>
  const menu = document.getElementById('mobile-menu')!;
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]')!;
  const closeBtn = menu.querySelector<HTMLButtonElement>('[data-menu-close]')!;

  const setOpen = (open: boolean) => {
    menu.dataset.open = String(open);
    menu.inert = !open;
    openBtn.setAttribute('aria-expanded', String(open));
    document.documentElement.style.overflow = open ? 'hidden' : '';
    (open ? closeBtn : openBtn).focus({ preventScroll: true });
  };

  openBtn.addEventListener('click', () => setOpen(true));
  closeBtn.addEventListener('click', () => setOpen(false));
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && menu.dataset.open === 'true') setOpen(false); });
  // Close if the viewport grows past the mobile breakpoint while open.
  matchMedia('(min-width: 1024px)').addEventListener('change', (e) => { if (e.matches && menu.dataset.open === 'true') setOpen(false); });
</script>
