---
// Wordmark from the designer's files (raster inside the SVG exports), served as WebP with PNG fallback.
interface Props {
  variant?: 'color' | 'white' | 'black';
  class?: string;
}
const { variant = 'color', class: className = 'h-9 w-auto' } = Astro.props;
const file = { color: 'upnestly', white: 'upnestly-white', black: 'upnestly-black' }[variant];
---

<picture>
  <source srcset={`/logo/${file}.webp`} type="image/webp" />
  <img src={`/logo/${file}.png`} alt="Upnestly" width="510" height="144" class={className} />
</picture>
