---
// Cookie consent with three categories: necessary (always on), analytics, marketing.
// Choice is stored in localStorage (`upn-consent`). Nothing optional is loaded today.
//
// To add a tracking script later, mark it so it only runs after consent:
//   <script type="text/plain" data-consent="analytics" src="https://…"></script>
//   <script type="text/plain" data-consent="marketing">/* pixel code */</script>
// Other code can listen for:  document.addEventListener('upnestly:consent', (e) => e.detail)
import { getLang, localize } from '../i18n';
const lang = getLang(Astro.url);
const t = {
  en: {
    text: 'We only use what’s necessary to run this site. With your permission we’d also use analytics to improve it.', policy: 'Cookie policy',
    necessary: 'Necessary', necessaryText: 'Remembers your choice and keeps the site secure. Always on.',
    analytics: 'Analytics', analyticsText: 'Helps us understand which pages are useful.',
    marketing: 'Marketing', marketingText: 'Measures our own ad campaigns.',
    accept: 'Accept all', reject: 'Necessary only', settings: 'Settings', save: 'Save choice',
  },
  de: {
    text: 'Wir verwenden nur, was für den Betrieb dieser Website notwendig ist. Mit Ihrer Erlaubnis nutzen wir zusätzlich Analysen, um sie zu verbessern.', policy: 'Cookie-Richtlinie',
    necessary: 'Notwendig', necessaryText: 'Speichert Ihre Auswahl und hält die Website sicher. Immer aktiv.',
    analytics: 'Analyse', analyticsText: 'Zeigt uns, welche Seiten hilfreich sind.',
    marketing: 'Marketing', marketingText: 'Misst unsere eigenen Werbekampagnen.',
    accept: 'Alle akzeptieren', reject: 'Nur notwendige', settings: 'Einstellungen', save: 'Auswahl speichern',
  },
}[lang];
---

<div
  id="cookie-banner"
  role="dialog"
  aria-modal="false"
  aria-labelledby="cookie-title"
  aria-describedby="cookie-text"
  class="fixed inset-x-0 bottom-0 z-[60] max-h-[85vh] overflow-y-auto rounded-t-[20px] border-t border-line bg-white px-5 pt-4 pb-[max(16px,env(safe-area-inset-bottom))] shadow-[0_-12px_40px_-20px_rgb(23_22_58/0.35)] sm:inset-x-auto sm:bottom-6 sm:left-6 sm:max-w-[480px] sm:rounded-[20px] sm:border sm:p-6 sm:shadow-[0_24px_60px_-24px_rgb(23_22_58/0.45)]"
  hidden
>
  <p id="cookie-title" class="m-0 text-[16px] font-extrabold text-ink sm:text-[18px]">Cookies</p>
  <p id="cookie-text" class="mt-1.5 mb-0 text-[14px] leading-snug text-body sm:mt-2 sm:text-[15px] sm:leading-relaxed">
    {t.text} <a href={localize('/cookies/', lang)}>{t.policy}</a>
  </p>

  <form class="mt-4 flex flex-col gap-3 border-t border-line-soft pt-4" data-cookie-prefs hidden>
    <label class="flex items-start gap-3 text-[14px] leading-snug text-body">
      <input type="checkbox" checked disabled class="mt-0.5 size-5 shrink-0 accent-[#2D327D]" />
      <span><strong class="text-ink">{t.necessary}</strong><br />{t.necessaryText}</span>
    </label>
    <label class="flex cursor-pointer items-start gap-3 text-[14px] leading-snug text-body">
      <input type="checkbox" name="analytics" class="mt-0.5 size-5 shrink-0 accent-[#2D327D]" />
      <span><strong class="text-ink">{t.analytics}</strong><br />{t.analyticsText}</span>
    </label>
    <label class="flex cursor-pointer items-start gap-3 text-[14px] leading-snug text-body">
      <input type="checkbox" name="marketing" class="mt-0.5 size-5 shrink-0 accent-[#2D327D]" />
      <span><strong class="text-ink">{t.marketing}</strong><br />{t.marketingText}</span>
    </label>
  </form>

  <div class="mt-3.5 flex flex-wrap items-center gap-2 sm:mt-5 sm:gap-2.5">
    <button type="button" class="btn btn-primary flex-1 cursor-pointer whitespace-nowrap border-0 !px-4 !py-2.5 !text-[15px] sm:flex-none sm:!px-5 sm:!py-3" data-cookie-accept>{t.accept}</button>
    <button type="button" class="btn btn-outline flex-1 cursor-pointer whitespace-nowrap !px-4 !py-2.5 !text-[15px] sm:flex-none sm:!px-5 sm:!py-3" data-cookie-necessary>{t.reject}</button>
    <button type="button" class="basis-full cursor-pointer border-0 bg-transparent px-0 py-1 text-left text-[14px] font-semibold sm:basis-auto sm:px-2 sm:py-2 sm:text-[15px] text-brand underline-offset-4 transition-colors duration-300 hover:text-brand-deep hover:underline" data-cookie-settings>{t.settings}</button>
    <button type="button" class="btn btn-outline cursor-pointer !px-5 !py-3 !text-[15px]" data-cookie-save hidden>{t.save}</button>
  </div>
</div>

<script>
  const KEY = 'upn-consent';
  const VERSION = 1;
  type Consent = { v: number; analytics: boolean; marketing: boolean; at: string };

  const banner = document.getElementById('cookie-banner') as HTMLElement;
  const prefs = banner.querySelector<HTMLFormElement>('[data-cookie-prefs]')!;
  const box = (name: string) => prefs.querySelector<HTMLInputElement>(`input[name="${name}"]`)!;
  const saveBtn = banner.querySelector<HTMLButtonElement>('[data-cookie-save]')!;
  const settingsBtn = banner.querySelector<HTMLButtonElement>('[data-cookie-settings]')!;

  const read = (): Consent | null => {
    try {
      const c = JSON.parse(localStorage.getItem(KEY) ?? 'null');
      return c && c.v === VERSION ? c : null;
    } catch {
      return null;
    }
  };

  // Activate <script type="text/plain" data-consent="…"> for allowed categories.
  const apply = (c: Consent | null) => {
    if (!c) return;
    document.querySelectorAll<HTMLScriptElement>('script[type="text/plain"][data-consent]').forEach((old) => {
      const cat = old.dataset.consent as 'analytics' | 'marketing';
      if (!c[cat]) return;
      const s = document.createElement('script');
      [...old.attributes].forEach((a) => { if (a.name !== 'type') s.setAttribute(a.name, a.value); });
      s.textContent = old.textContent;
      old.replaceWith(s);
    });
    document.dispatchEvent(new CustomEvent('upnestly:consent', { detail: c }));
  };

  const write = (analytics: boolean, marketing: boolean) => {
    const c: Consent = { v: VERSION, analytics, marketing, at: new Date().toISOString() };
    try { localStorage.setItem(KEY, JSON.stringify(c)); } catch { /* private mode */ }
    apply(c);
    banner.hidden = true;
  };

  const open = (withSettings = false) => {
    const c = read();
    box('analytics').checked = c?.analytics ?? false;
    box('marketing').checked = c?.marketing ?? false;
    prefs.hidden = !withSettings;
    saveBtn.hidden = !withSettings;
    settingsBtn.hidden = withSettings;
    banner.hidden = false;
  };

  banner.querySelector('[data-cookie-accept]')!.addEventListener('click', () => write(true, true));
  banner.querySelector('[data-cookie-necessary]')!.addEventListener('click', () => write(false, false));
  settingsBtn.addEventListener('click', () => open(true));
  saveBtn.addEventListener('click', () => write(box('analytics').checked, box('marketing').checked));

  // "Cookie settings" links (footer, legal pages)
  document.querySelectorAll('[data-open-cookie-settings]').forEach((el) =>
    el.addEventListener('click', (e) => { e.preventDefault(); open(true); }),
  );

  const current = read();
  if (current) apply(current);
  else open();
</script>
